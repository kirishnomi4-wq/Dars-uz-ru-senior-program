 {
  "file": "src/4a-Modull/NestArchAliveLesson.jsx",
  "sid": "s19",
  "test": true,
  "note": "Q4 (F5): xato qatorni bosish = xato urinish; to'g'ri qator topilib service fayliga sudraladi",
  "right": [
   {
    "click": ".ai-line:has-text(\"bcrypt.hash\")",
    "after": 500
   },
   {
    "eval": "(() => { const el=document.querySelector('.ai-line.rz-move'); const z=document.querySelector('.rz-drop'); const a=el.getBoundingClientRect(), b=z.getBoundingClientRect(); const sx=a.left+a.width/2, sy=a.top+a.height/2, ex=b.left+b.width/2, ey=b.top+b.height/2; el.dispatchEvent(new PointerEvent('pointerdown',{bubbles:true,cancelable:true,clientX:sx,clientY:sy,button:0,pointerId:1})); window.dispatchEvent(new PointerEvent('pointermove',{clientX:ex,clientY:ey,pointerId:1})); window.dispatchEvent(new PointerEvent('pointerup',{clientX:ex,clientY:ey,pointerId:1})); })()",
    "after": 900
   }
  ],
  "wrong": [
   {
    "click": ".ai-line:has-text(\"async create\")",
    "after": 700
   }
  ],
  "rightAfterWrong": [
   {
    "click": ".ai-line:has-text(\"bcrypt.hash\")",
    "after": 500
   },
   {
    "eval": "(() => { const el=document.querySelector('.ai-line.rz-move'); const z=document.querySelector('.rz-drop'); const a=el.getBoundingClientRect(), b=z.getBoundingClientRect(); const sx=a.left+a.width/2, sy=a.top+a.height/2, ex=b.left+b.width/2, ey=b.top+b.height/2; el.dispatchEvent(new PointerEvent('pointerdown',{bubbles:true,cancelable:true,clientX:sx,clientY:sy,button:0,pointerId:1})); window.dispatchEvent(new PointerEvent('pointermove',{clientX:ex,clientY:ey,pointerId:1})); window.dispatchEvent(new PointerEvent('pointerup',{clientX:ex,clientY:ey,pointerId:1})); })()",
    "after": 900
   }
  ]
 },
