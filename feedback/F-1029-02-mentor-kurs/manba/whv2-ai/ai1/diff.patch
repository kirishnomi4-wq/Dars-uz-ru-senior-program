+  const send = (body, secret = PAY_SECRET) => {
+    const raw = JSON.stringify(body);
+    const headers = { 'Content-Type': 'application/json' };
+    if (secret)
+      headers['X-Signature'] = createHmac('sha256', secret)
+        .update(raw)
+        .digest('hex');
+    return fetch(`${url}/payments/webhook`, {
+      method: 'POST',
+      headers,
+      body: raw,
+    });
+  };
+  const wait = (c, ev, ms = 3000) =>
+    new Promise((ok) => {
+      const tm = setTimeout(() => ok(null), ms);
+      c.once(ev, (x) => {
+        clearTimeout(tm);
+        ok(x === undefined ? true : x);
+      });
+    });
+  const panel = async () =>
