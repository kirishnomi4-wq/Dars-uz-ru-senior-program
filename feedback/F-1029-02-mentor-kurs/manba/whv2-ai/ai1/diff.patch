+import { INestApplication } from '@nestjs/common';
+import { Test } from '@nestjs/testing';
+import request from 'supertest';
+import { config } from '../../config';
+import { LiveGateway } from '../live/live.gateway';
+import { PaymentController } from './payment.controller';
+import { PaymentService } from './payment.service';
+import { sign } from './signature';
+
+// Baza o'rniga mock: apply() natijasini o'zimiz beramiz; tekshiramiz — imzo, tana, javob, panelga hodisa
+const apply = jest.fn();
+const orderChanged = jest.fn();
+const SECRET = 'sinov-kalit';
+const body = JSON.stringify({
+  payment_id: 'pay_1',
+  order_id: 12,
+  status: 'paid',
+  amount: 100000,
+});
+
+describe('PaymentController', () => {
+  let app: INestApplication;
+  const post = (raw: string, sig?: string) => {
+    const r = request(app.getHttpServer())
+      .post('/payments/webhook')
+      .set('Content-Type', 'application/json');
+    if (sig !== undefined) r.set('X-Signature', sig);
+    return r.send(raw);
+  };
+
+  beforeAll(async () => {
+    config.PAYMENT_WEBHOOK_SECRET = SECRET;
+    const mod = await Test.createTestingModule({
+      controllers: [PaymentController],
+      providers: [
+        { provide: PaymentService, useValue: { apply } },
+        { provide: LiveGateway, useValue: { orderChanged } },
+      ],
+    }).compile();
+    app = mod.createNestApplication({ rawBody: true, logger: false });
+    await app.init();
+  });
+  beforeEach(() => jest.clearAllMocks());
+  afterAll(() => app.close());
+
+  it('imzosiz — 401, bazaga tegilmaydi', async () => {
+    const res = await post(body);
+    expect(res.status).toBe(401);
+    expect(apply).not.toHaveBeenCalled();
+  });
+
+  it('boshqa kalit bilan imzolangan — 401', async () => {
+    const res = await post(body, sign(body, 'boshqa'));
+    expect(res.status).toBe(401);
+    expect(apply).not.toHaveBeenCalled();
+  });
+
+  it("imzodan keyin tana o'zgartirilgan (summa) — 401", async () => {
+    const sig = sign(body, SECRET);
+    const res = await post(body.replace('100000', '1'), sig);
+    expect(res.status).toBe(401);
+  });
+
+  it("imzo to'g'ri — 200, apply chaqiriladi, panelga order-changed payment", async () => {
+    apply.mockResolvedValue({
+      result: 'applied',
+      orderId: 12,
+      paymentStatus: 'PAID',
+    });
+    const res = await post(body, sign(body, SECRET));
+    expect(res.status).toBe(200);
+    expect(res.body).toEqual({
+      ok: true,
+      result: 'applied',
+      order_id: 12,
+      payment_status: 'PAID',
+    });
+    expect(apply).toHaveBeenCalledWith(JSON.parse(body));
+    expect(orderChanged).toHaveBeenCalledWith(12, 'payment');
+  });
+
+  it('takror xabar — 200, panelga hodisa ketmaydi', async () => {
+    apply.mockResolvedValue({
+      result: 'duplicate',
+      orderId: 12,
+      paymentStatus: 'PAID',
+    });
+    const res = await post(body, sign(body, SECRET));
+    expect(res.status).toBe(200);
+    expect(res.body.result).toBe('duplicate');
+    expect(orderChanged).not.toHaveBeenCalled();
+  });
+
+  it("imzo to'g'ri, lekin tana noto'g'ri — 400", async () => {
+    const bad = JSON.stringify({
+      payment_id: 'x',
+      order_id: 1,
+      status: 'ok',
+      amount: 5,
+    });
+    const res = await post(bad, sign(bad, SECRET));
+    expect(res.status).toBe(400);
+    expect(apply).not.toHaveBeenCalled();
+  });
+
+  it("kalit .env da bo'sh — hammasi 401", async () => {
+    config.PAYMENT_WEBHOOK_SECRET = '';
+    const res = await post(body, sign(body, ''));
+    config.PAYMENT_WEBHOOK_SECRET = SECRET;
+    expect(res.status).toBe(401);
+  });
+});
