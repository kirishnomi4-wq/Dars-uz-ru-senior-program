@@ -0,0 +1,59 @@
+import { orderPaymentStatus, parsePaymentEvent } from './payment-event';
+
+const raw = (o: unknown) => Buffer.from(JSON.stringify(o));
+const ok = { payment_id: 'p1', order_id: 7, status: 'paid', amount: 120000 };
+
+describe('parsePaymentEvent', () => {
+  it("to'g'ri xabar", () => {
+    expect(parsePaymentEvent(raw(ok))).toEqual(ok);
+  });
+
+  it('raqamli payment_id va matnli order_id ham qabul qilinadi', () => {
+    expect(
+      parsePaymentEvent(raw({ ...ok, payment_id: 555, order_id: '7' })),
+    ).toEqual({ ...ok, payment_id: '555' });
+  });
+
+  it.each([
+    ['JSON emas', Buffer.from('salom')],
+    ['massiv', raw([ok])],
+    ["payment_id yo'q", raw({ ...ok, payment_id: '' })],
+    ['order_id manfiy', raw({ ...ok, order_id: -1 })],
+    ['order_id INTEGER dan katta', raw({ ...ok, order_id: 3000000000 })],
+    ["status noma'lum", raw({ ...ok, status: 'PAID' })],
+    ['amount kasr', raw({ ...ok, amount: 10.5 })],
+    ['amount matn', raw({ ...ok, amount: '120000' })],
+  ])('%s — 400', (_name, body) => {
+    expect(() => parsePaymentEvent(body)).toThrow();
+  });
+});
+
+describe('orderPaymentStatus', () => {
+  const total = 120000;
+  it("urinish yo'q — UNPAID", () => {
+    expect(orderPaymentStatus([], total)).toBe('UNPAID');
+  });
+  it("rad etildi — REJECTED; keyin to'landi — PAID", () => {
+    const rej = { status: 'rejected' as const, amount: total };
+    expect(orderPaymentStatus([rej], total)).toBe('REJECTED');
+    expect(
+      orderPaymentStatus([rej, { status: 'paid', amount: total }], total),
+    ).toBe('PAID');
+  });
+  it("to'landi, lekin summa boshqa — AMOUNT_MISMATCH", () => {
+    expect(orderPaymentStatus([{ status: 'paid', amount: 1000 }], total)).toBe(
+      'AMOUNT_MISMATCH',
+    );
+  });
+  it("to'langandan keyingi rad etilgan urinish PAID ni o'zgartirmaydi", () => {
+    expect(
+      orderPaymentStatus(
+        [
+          { status: 'paid', amount: total },
+          { status: 'rejected', amount: total },
+        ],
+        total,
+      ),
+    ).toBe('PAID');
+  });
+});
diff --git a/src/api/payment/payment-event.ts b/src/api/payment/payment-event.ts
new file mode 100644
index 0000000..be193a1
--- /dev/null
+++ b/src/api/payment/payment-event.ts
@@ -0,0 +1,68 @@
+import { BadRequestException } from '@nestjs/common';
+import type { PaymentResultStatus, PaymentStatus } from '../../core/entity';
+
+// To'lov xizmati yuboradigan xabar (JSON):
+//   { "payment_id": "pay_123", "order_id": 15, "status": "paid" | "rejected", "amount": 120000 }
+// amount — so'mda, butun son (orders.total bilan bir xil birlik).
+export interface PaymentEvent {
+  payment_id: string;
+  order_id: number;
+  status: PaymentResultStatus;
+  amount: number;
+}
+
+const INT4_MAX = 2147483647; // PostgreSQL INTEGER chegarasi
+const isPosInt = (v: unknown): v is number =>
+  typeof v === 'number' && Number.isInteger(v) && v > 0 && v <= INT4_MAX;
+
+export function parsePaymentEvent(raw: Buffer): PaymentEvent {
+  let b: Record<string, unknown>;
+  try {
+    b = JSON.parse(raw.toString('utf8'));
+  } catch {
+    throw new BadRequestException('Tana JSON emas');
+  }
+  if (!b || typeof b !== 'object' || Array.isArray(b))
+    throw new BadRequestException("Tana JSON obyekt bo'lishi kerak");
+
+  const pid =
+    typeof b.payment_id === 'number' && Number.isInteger(b.payment_id)
+      ? String(b.payment_id)
+      : b.payment_id;
+  if (typeof pid !== 'string' || pid.trim() === '' || pid.length > 200)
+    throw new BadRequestException("payment_id noto'g'ri");
+
+  const oid =
+    typeof b.order_id === 'string' && /^\d+$/.test(b.order_id)
+      ? Number(b.order_id)
+      : b.order_id;
+  if (!isPosInt(oid)) throw new BadRequestException("order_id noto'g'ri");
+
+  if (b.status !== 'paid' && b.status !== 'rejected')
+    throw new BadRequestException(
+      "status 'paid' yoki 'rejected' bo'lishi kerak",
+    );
+
+  if (!isPosInt(b.amount))
+    throw new BadRequestException("amount musbat butun son bo'lishi kerak");
+
+  return {
+    payment_id: pid.trim(),
+    order_id: oid,
+    status: b.status,
+    amount: b.amount,
+  };
+}
+
+// Buyurtmaning to'lov holati — uning hamma to'lov urinishlaridan:
+// bitta urinish «to'landi» va summasi jamiga teng bo'lsa — PAID (keyingi rad urinishlar uni bekor qilmaydi).
+export function orderPaymentStatus(
+  payments: { status: PaymentResultStatus; amount: number }[],
+  total: number,
+): PaymentStatus {
+  if (payments.some((p) => p.status === 'paid' && p.amount === total))
+    return 'PAID';
+  if (payments.some((p) => p.status === 'paid')) return 'AMOUNT_MISMATCH';
+  if (payments.some((p) => p.status === 'rejected')) return 'REJECTED';
+  return 'UNPAID';
+}
