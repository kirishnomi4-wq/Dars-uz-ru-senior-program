@@ -0,0 +1,31 @@
+import { isValidSignature, sign } from './signature';
+
+const secret = 'sinov-kalit';
+const body = Buffer.from(
+  '{"payment_id":"p1","order_id":1,"status":"paid","amount":100}',
+);
+
+describe('isValidSignature', () => {
+  it("to'g'ri imzo — o'tadi (hex, katta harf ham, sha256= bilan ham)", () => {
+    const s = sign(body, secret);
+    expect(isValidSignature(body, s, secret)).toBe(true);
+    expect(isValidSignature(body, s.toUpperCase(), secret)).toBe(true);
+    expect(isValidSignature(body, `sha256=${s}`, secret)).toBe(true);
+  });
+
+  it("tanadagi bitta bayt o'zgarsa — o'tmaydi", () => {
+    const s = sign(body, secret);
+    const other = Buffer.from(body.toString().replace('100', '101'));
+    expect(isValidSignature(other, s, secret)).toBe(false);
+  });
+
+  it("boshqa kalit, imzosiz, noto'g'ri uzunlik — o'tmaydi", () => {
+    expect(isValidSignature(body, sign(body, 'boshqa'), secret)).toBe(false);
+    expect(isValidSignature(body, undefined, secret)).toBe(false);
+    expect(isValidSignature(body, 'abc', secret)).toBe(false);
+  });
+
+  it("kalit bo'sh bo'lsa — hech narsa o'tmaydi (bo'sh kalit bilan imzolangan ham)", () => {
+    expect(isValidSignature(body, sign(body, ''), '')).toBe(false);
+  });
+});
