@@ -0,0 +1,25 @@
+import { createHmac, timingSafeEqual } from 'crypto';
+
+// X-Signature = HMAC-SHA256(kalit, so'rov tanasining AYNAN o'zi), hex ko'rinishda (64 belgi).
+// «sha256=» old qo'shimchasi bo'lsa ham qabul qilinadi. Tana qayta JSON qilinmaydi:
+// probel yoki maydonlar tartibi o'zgarsa imzo boshqa chiqadi — shuning uchun xom baytlar (req.rawBody).
+// Kalit bo'sh bo'lsa — hech qaysi xabar o'tmaydi.
+export function sign(raw: Buffer | string, secret: string): string {
+  return createHmac('sha256', secret).update(raw).digest('hex');
+}
+
+export function isValidSignature(
+  raw: Buffer,
+  header: string | undefined,
+  secret: string,
+): boolean {
+  if (!secret || typeof header !== 'string') return false;
+  const got = header
+    .trim()
+    .replace(/^sha256=/i, '')
+    .toLowerCase();
+  if (!/^[0-9a-f]{64}$/.test(got)) return false;
+  const want = createHmac('sha256', secret).update(raw).digest();
+  // timingSafeEqual — javob vaqti qaysi belgigacha mos kelganini oshkor qilmaydi
+  return timingSafeEqual(Buffer.from(got, 'hex'), want);
+}
