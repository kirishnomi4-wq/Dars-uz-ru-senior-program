@@ -0,0 +1,69 @@
+import {
+  BadRequestException,
+  Controller,
+  Headers,
+  HttpCode,
+  InternalServerErrorException,
+  Logger,
+  Post,
+  Req,
+  UnauthorizedException,
+} from '@nestjs/common';
+import type { RawBodyRequest } from '@nestjs/common';
+import type { Request } from 'express';
+import { config } from '../../config';
+import { LiveGateway } from '../live/live.gateway';
+import { parsePaymentEvent } from './payment-event';
+import { PaymentService } from './payment.service';
+import { isValidSignature } from './signature';
+
+// To'lov xizmati shu manzilga natijani yuboradi: POST /payments/webhook
+//   Content-Type: application/json
+//   X-Signature: <HMAC-SHA256(PAYMENT_WEBHOOK_SECRET, tana) hex>
+//   { "payment_id": "...", "order_id": 15, "status": "paid" | "rejected", "amount": 120000 }
+// Javoblar: 200 — qabul qilindi (takror xabar ham 200: xizmat qayta yubormasin) ·
+// 401 — imzo yo'q/noto'g'ri · 400 — tana noto'g'ri · 404 — buyurtma yo'q ·
+// 409 — payment_id boshqa buyurtmaga tegishli · 5xx — bizda xato (xizmat keyin qayta yuboradi)
+@Controller('payments')
+export class PaymentController {
+  private readonly log = new Logger('Payment');
+
+  constructor(
+    private readonly payments: PaymentService,
+    private readonly live: LiveGateway,
+  ) {}
+
+  @Post('webhook')
+  @HttpCode(200)
+  async webhook(
+    @Req() req: RawBodyRequest<Request>,
+    @Headers('x-signature') signature?: string,
+  ) {
+    const raw = req.rawBody;
+    if (!Buffer.isBuffer(raw)) {
+      if (req.is('application/json'))
+        // server rawBody'siz ko'tarilgan — main.ts: NestFactory.create(AppModule, { rawBody: true })
+        throw new InternalServerErrorException('rawBody yoqilmagan');
+      throw new BadRequestException('Content-Type: application/json kerak');
+    }
+    // Imzo — birinchi: imzosiz xabarning ichiga qaramaymiz ham
+    if (!isValidSignature(raw, signature, config.PAYMENT_WEBHOOK_SECRET)) {
+      this.log.warn(`imzo noto'g'ri yoki yo'q (${req.ip})`);
+      throw new UnauthorizedException("Imzo noto'g'ri");
+    }
+    const event = parsePaymentEvent(raw);
+    const out = await this.payments.apply(event);
+    this.log.log(
+      `${event.payment_id} · #${event.order_id} · ${event.status} ${event.amount} → ${out.result}, ${out.paymentStatus}`,
+    );
+    // tranzaksiya tugadi — ochiq panellar ro'yxatni qayta so'raydi
+    if (out.result === 'applied')
+      this.live.orderChanged(out.orderId, 'payment');
+    return {
+      ok: true,
+      result: out.result,
+      order_id: out.orderId,
+      payment_status: out.paymentStatus,
+    };
+  }
+}
