+import { Module } from '@nestjs/common';
+import { LiveModule } from '../live/live.module';
+import { PaymentController } from './payment.controller';
+import { PaymentService } from './payment.service';
+
+// Onlayn to'lov: to'lov xizmati webhook'i (POST /payments/webhook) → payments jadvali,
+// orders.payment_status → jonli panelga order-changed { reason: 'payment' }
+@Module({
+  imports: [LiveModule],
+  controllers: [PaymentController],
+  providers: [PaymentService],
+})
+export class PaymentModule {}
diff --git a/src/api/payment/payment.service.ts b/src/api/payment/payment.service.ts
new file mode 100644
index 0000000..53922c2
--- /dev/null
+++ b/src/api/payment/payment.service.ts
@@ -0,0 +1,94 @@
+import {
+  ConflictException,
+  Injectable,
+  Logger,
+  NotFoundException,
+} from '@nestjs/common';
+import { DataSource } from 'typeorm';
+import { Order, Payment, PaymentStatus } from '../../core/entity';
+import { orderPaymentStatus, PaymentEvent } from './payment-event';
+
+// applied — yangi ma'lumot yozildi · duplicate — aynan shu xabar avval kelgan (xizmat qayta yubordi) ·
+// ignored — bu to'lov allaqachon «to'landi», keyingi «rad etildi» uni o'zgartirmaydi
+export type PaymentApplyResult = 'applied' | 'duplicate' | 'ignored';
+
+export interface PaymentApplyOutcome {
+  result: PaymentApplyResult;
+  orderId: number;
+  paymentStatus: PaymentStatus;
+}
+
+@Injectable()
+export class PaymentService {
+  private readonly log = new Logger('Payment');
+
+  constructor(private readonly ds: DataSource) {}
+
+  // Bitta tranzaksiya. Buyurtma qatori qulflanadi (FOR UPDATE): bitta buyurtmaga ikki xabar
+  // bir vaqtda kelsa (xizmat qayta yuborganda bo'ladi) — ikkinchisi birinchisi tugashini kutadi va
+  // yozilgan to'lovni ko'radi, ikkinchi qator ochilmaydi.
+  apply(e: PaymentEvent): Promise<PaymentApplyOutcome> {
+    return this.ds
+      .transaction(async (m) => {
+        const rows: { id: number; total: number }[] = await m.query(
+          'SELECT id, total FROM orders WHERE id = $1 FOR UPDATE',
+          [e.order_id],
+        );
+        if (rows.length === 0)
+          throw new NotFoundException(`Buyurtma topilmadi: #${e.order_id}`);
+        const total = Number(rows[0].total);
+
+        let result: PaymentApplyResult;
+        const old = await m.findOneBy(Payment, { payment_id: e.payment_id });
+        if (!old) {
+          await m.insert(Payment, {
+            payment_id: e.payment_id,
+            order_id: e.order_id,
+            status: e.status,
+            amount: e.amount,
+          });
+          result = 'applied';
+        } else if (old.order_id !== e.order_id) {
+          throw new ConflictException(
+            `payment_id ${e.payment_id} boshqa buyurtmaga (#${old.order_id}) tegishli`,
+          );
+        } else if (old.status === e.status && old.amount === e.amount) {
+          result = 'duplicate';
+        } else if (old.status === 'paid') {
+          this.log.warn(
+            `${e.payment_id}: allaqachon paid/${old.amount}, keldi ${e.status}/${e.amount} — o'zgartirilmadi`,
+          );
+          result = 'ignored';
+        } else {
+          await m.update(
+            Payment,
+            { id: old.id },
+            { status: e.status, amount: e.amount },
+          );
+          result = 'applied';
+        }
+
+        const all = await m.find(Payment, {
+          where: { order_id: e.order_id },
+          select: { status: true, amount: true },
+        });
+        const paymentStatus = orderPaymentStatus(all, total);
+        await m.update(
+          Order,
+          { id: e.order_id },
+          { payment_status: paymentStatus },
+        );
+        if (paymentStatus === 'AMOUNT_MISMATCH')
+          this.log.warn(
+            `#${e.order_id}: to'langan ${e.amount}, buyurtma jami ${total}`,
+          );
+        return { result, orderId: e.order_id, paymentStatus };
+      })
+      .catch((err: { code?: string }) => {
+        // 23505 — UNIQUE buzildi: bir xil payment_id ikki xil buyurtma bilan bir vaqtda keldi
+        if (err?.code === '23505')
+          throw new ConflictException(`payment_id ${e.payment_id} takrorlandi`);
+        throw err;
+      });
+  }
+}
