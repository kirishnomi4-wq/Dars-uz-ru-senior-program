@@ -0,0 +1,86 @@
+import { createHmac } from 'crypto';
+import { parsePaymentEvent, verifySignature } from './payment-webhook';
+
+const SECRET = 'sinov-kalit';
+const body = Buffer.from(
+  JSON.stringify({
+    payment_id: 'P-1',
+    order_id: 1,
+    status: 'paid',
+    amount: 100,
+  }),
+);
+const sign = (b: Buffer, key = SECRET) =>
+  createHmac('sha256', key).update(b).digest('hex');
+
+describe('verifySignature', () => {
+  it("to'g'ri imzo — o'tadi", () => {
+    expect(verifySignature(body, sign(body), SECRET)).toBe(true);
+  });
+
+  it("katta-kichik harf farqi bo'lmaydi (hex)", () => {
+    expect(verifySignature(body, sign(body).toUpperCase(), SECRET)).toBe(true);
+  });
+
+  it("tana o'zgarsa — rad", () => {
+    const tampered = Buffer.from(body.toString().replace('100', '1'));
+    expect(verifySignature(tampered, sign(body), SECRET)).toBe(false);
+  });
+
+  it("noto'g'ri kalit bilan imzo — rad", () => {
+    expect(verifySignature(body, sign(body, 'boshqa'), SECRET)).toBe(false);
+  });
+
+  it("imzo yo'q, bo'sh yoki noto'g'ri uzunlikda — rad", () => {
+    expect(verifySignature(body, undefined, SECRET)).toBe(false);
+    expect(verifySignature(body, '', SECRET)).toBe(false);
+    expect(verifySignature(body, 'abcd', SECRET)).toBe(false);
+    expect(verifySignature(body, 'z'.repeat(64), SECRET)).toBe(false);
+  });
+
+  it("kalit sozlanmagan (bo'sh) — hech narsa o'tmaydi", () => {
+    expect(verifySignature(body, sign(body, ''), '')).toBe(false);
+  });
+
+  it("xom tana yo'q — rad", () => {
+    expect(verifySignature(undefined, sign(body), SECRET)).toBe(false);
+  });
+});
+
+describe('parsePaymentEvent', () => {
+  const ok = {
+    payment_id: 'P-1',
+    order_id: 12,
+    status: 'paid',
+    amount: 100000,
+  };
+
+  it("to'g'ri xabar — ichki shaklga o'tadi", () => {
+    expect(parsePaymentEvent(ok)).toEqual({
+      paymentId: 'P-1',
+      orderId: 12,
+      status: 'PAID',
+      amount: 100000,
+    });
+  });
+
+  it("rejected — REJECTED; payment_id raqam bo'lsa ham qabul qilinadi", () => {
+    expect(
+      parsePaymentEvent({ ...ok, payment_id: 555, status: 'rejected' }),
+    ).toMatchObject({ paymentId: '555', status: 'REJECTED' });
+  });
+
+  it.each([
+    ["payment_id yo'q", { payment_id: undefined }],
+    ['order_id matn', { order_id: 'abc' }],
+    ['order_id kasr', { order_id: 1.5 }],
+    ["status noma'lum", { status: 'pending' }],
+    ['summa manfiy', { amount: -1 }],
+    ['summa kasr', { amount: 10.5 }],
+    ['summa matn', { amount: '100' }],
+  ])('%s — 400', (_name, patch) => {
+    expect(() => parsePaymentEvent({ ...ok, ...patch })).toThrow(
+      expect.objectContaining({ status: 400 }),
+    );
+  });
+});
