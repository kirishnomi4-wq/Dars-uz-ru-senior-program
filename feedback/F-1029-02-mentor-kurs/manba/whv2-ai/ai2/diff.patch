+++ b/src/api/payment/payment.controller.ts
@@ -0,0 +1,42 @@
+import {
+  BadRequestException,
+  Body,
+  Controller,
+  Headers,
+  HttpCode,
+  Post,
+  Req,
+  UnauthorizedException,
+} from '@nestjs/common';
+import type { Request } from 'express';
+import { config } from '../../config';
+import { parsePaymentEvent, verifySignature } from './payment-webhook';
+import { PaymentService } from './payment.service';
+
+type RawRequest = Request & { rawBody?: Buffer };
+
+@Controller('webhooks')
+export class PaymentController {
+  constructor(private readonly payments: PaymentService) {}
+
+  // To'lov xizmati shu yerga POST yuboradi. Imzo — X-Signature sarlavhasida (xom tana bo'yicha).
+  // Javob: 200 { ok: true } — xizmat 200 ni ko'rsa, qayta yubormaydi.
+  @Post('payment')
+  @HttpCode(200)
+  async handle(
+    @Req() req: RawRequest,
+    @Headers('x-signature') signature: string | undefined,
+    @Body() body: unknown,
+  ) {
+    if (
+      !verifySignature(req.rawBody, signature, config.PAYMENT_WEBHOOK_SECRET)
+    ) {
+      throw new UnauthorizedException("Imzo noto'g'ri");
+    }
+    if (!body || typeof body !== 'object') {
+      throw new BadRequestException('JSON tana kutilgan');
+    }
+    const payment = await this.payments.record(parsePaymentEvent(body));
+    return { ok: true, status: payment.status };
+  }
+}
