@@ -0,0 +1,142 @@
+import { INestApplication } from '@nestjs/common';
+import { Test } from '@nestjs/testing';
+import { createHmac } from 'crypto';
+import request from 'supertest';
+import { DataSource } from 'typeorm';
+import { config } from '../../config';
+import { Order, Payment } from '../../core/entity';
+import { LiveGateway } from '../live/live.gateway';
+import { PaymentController } from './payment.controller';
+import { PaymentService } from './payment.service';
+
+// Baza o'rniga soxta tranzaksiya: buyurtma #7 (jami 100000), to'lovlar — xotirada
+const store: { payments: any[] } = { payments: [] };
+let nextId = 1;
+const order = { id: 7, total: 100000 };
+
+const manager = {
+  query: jest.fn(async () => []),
+  findOneBy: jest.fn(async (cls: unknown, where: { id: number }) =>
+    cls === Order && where.id === 7 ? order : null,
+  ),
+  findOne: jest.fn(
+    async (_cls: unknown, opts: any) =>
+      store.payments.find((p) => p.external_id === opts.where.external_id) ??
+      null,
+  ),
+  create: jest.fn((_cls, data) => ({ ...data })),
+  save: jest.fn(async (p: any) => {
+    if (!p.id) {
+      p.id = nextId++;
+      p.received_at = new Date('2026-11-04T10:00:00Z');
+      store.payments.push(p);
+    }
+    return p;
+  }),
+};
+const dataSource = { transaction: jest.fn((cb) => cb(manager)) };
+const live = { orderChanged: jest.fn() };
+
+const SECRET = 'sinov-webhook-kalit';
+const sign = (raw: string) =>
+  createHmac('sha256', SECRET).update(raw).digest('hex');
+
+describe('POST /webhooks/payment', () => {
+  let app: INestApplication;
+
+  beforeAll(async () => {
+    config.PAYMENT_WEBHOOK_SECRET = SECRET;
+    const mod = await Test.createTestingModule({
+      controllers: [PaymentController],
+      providers: [
+        PaymentService,
+        { provide: DataSource, useValue: dataSource },
+        { provide: LiveGateway, useValue: live },
+      ],
+    }).compile();
+    app = mod.createNestApplication({ logger: false, rawBody: true });
+    await app.init();
+  });
+
+  afterAll(() => app.close());
+
+  beforeEach(() => {
+    store.payments = [];
+    jest.clearAllMocks();
+  });
+
+  const post = (raw: string, sig?: string) => {
+    const r = request(app.getHttpServer())
+      .post('/webhooks/payment')
+      .set('Content-Type', 'application/json');
+    if (sig !== undefined) r.set('X-Signature', sig);
+    return r.send(raw);
+  };
+  const body = (over: object = {}) =>
+    JSON.stringify({
+      payment_id: 'P-100',
+      order_id: 7,
+      status: 'paid',
+      amount: 100000,
+      ...over,
+    });
+
+  it("imzo to'g'ri — 200, to'lov yoziladi, panelga xabar ketadi", async () => {
+    const raw = body();
+    const res = await post(raw, sign(raw));
+    expect(res.status).toBe(200);
+    expect(res.body).toEqual({ ok: true, status: 'PAID' });
+    expect(store.payments).toHaveLength(1);
+    expect(store.payments[0]).toMatchObject({
+      external_id: 'P-100',
+      status: 'PAID',
+      amount: 100000,
+    });
+    expect(live.orderChanged).toHaveBeenCalledWith(7, 'payment');
+  });
+
+  it("imzo yo'q — 401, hech narsa yozilmaydi", async () => {
+    const res = await post(body());
+    expect(res.status).toBe(401);
+    expect(dataSource.transaction).not.toHaveBeenCalled();
+    expect(live.orderChanged).not.toHaveBeenCalled();
+  });
+
+  it("tana imzodan keyin o'zgarsa — 401", async () => {
+    const raw = body();
+    const res = await post(body({ amount: 1 }), sign(raw));
+    expect(res.status).toBe(401);
+    expect(store.payments).toHaveLength(0);
+  });
+
+  it("imzo to'g'ri, lekin maydon yo'q — 400", async () => {
+    const raw = body({ status: 'bekor' });
+    const res = await post(raw, sign(raw));
+    expect(res.status).toBe(400);
+  });
+
+  it("mavjud bo'lmagan buyurtma — 404", async () => {
+    const raw = body({ order_id: 999 });
+    const res = await post(raw, sign(raw));
+    expect(res.status).toBe(404);
+    expect(store.payments).toHaveLength(0);
+  });
+
+  it("takror xabar (xuddi shu payment_id) — ikkinchi qator yo'q, holat yangilanadi", async () => {
+    const first = body();
+    await post(first, sign(first));
+    const second = body({ status: 'rejected', amount: 100000 });
+    const res = await post(second, sign(second));
+    expect(res.status).toBe(200);
+    expect(res.body.status).toBe('REJECTED');
+    expect(store.payments).toHaveLength(1);
+    expect(store.payments[0].status).toBe('REJECTED');
+  });
+
+  it('boshqa buyurtmadagi payment_id — 409', async () => {
+    store.payments.push({ id: 50, external_id: 'P-100', order: { id: 3 } });
+    const raw = body();
+    const res = await post(raw, sign(raw));
+    expect(res.status).toBe(409);
+  });
+});
diff --git a/src/api/payment/payment.controller.ts b/src/api/payment/payment.controller.ts
new file mode 100644
