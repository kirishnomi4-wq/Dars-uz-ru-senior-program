@@ -0,0 +1,35 @@
+import {
+  Column,
+  CreateDateColumn,
+  Entity,
+  JoinColumn,
+  ManyToOne,
+  PrimaryGeneratedColumn,
+} from 'typeorm';
+import { Order } from './order.entity';
+
+// To'lov xizmatidan kelgan natija. PAID — to'landi, REJECTED — rad etildi.
+export type PaymentStatus = 'PAID' | 'REJECTED';
+
+// Har to'lov (to'lov xizmatining raqami bilan) — bitta qator. external_id bo'yicha takror xabar ikki marta yozilmaydi.
+@Entity('payments')
+export class Payment {
+  @PrimaryGeneratedColumn()
+  id: number;
+
+  @ManyToOne(() => Order, (o) => o.payments)
+  @JoinColumn({ name: 'order_id' })
+  order: Order;
+
+  @Column({ name: 'external_id', type: 'varchar', unique: true })
+  external_id: string;
+
+  @Column({ type: 'varchar' })
+  status: PaymentStatus;
+
+  @Column({ type: 'integer' })
+  amount: number;
+
+  @CreateDateColumn({ name: 'received_at' })
+  received_at: Date;
+}
