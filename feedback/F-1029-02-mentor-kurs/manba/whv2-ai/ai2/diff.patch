+import {
+  ConflictException,
+  Injectable,
+  Logger,
+  NotFoundException,
+} from '@nestjs/common';
+import { DataSource } from 'typeorm';
+import { Order, Payment } from '../../core/entity';
+import { LiveGateway } from '../live/live.gateway';
+import type { PaymentEvent } from './payment-webhook';
+
+@Injectable()
+export class PaymentService {
+  private readonly log = new Logger('Payment');
+
+  constructor(
+    private readonly ds: DataSource,
+    private readonly live: LiveGateway,
+  ) {}
+
+  // Bitta tranzaksiya: buyurtma qatori qulflanadi (bir vaqtdagi ikki xabar ketma-ket o'tadi),
+  // shu external_id bor bo'lsa — yangilanadi (takror xabar), yo'q bo'lsa — yoziladi.
+  // Buyurtma holati o'zgarmaydi: to'lov alohida ko'rinadi.
+  async record(ev: PaymentEvent): Promise<Payment> {
+    const { payment, total } = await this.ds.transaction(async (m) => {
+      await m.query('SELECT id FROM orders WHERE id = $1 FOR UPDATE', [
+        ev.orderId,
+      ]);
+      const order = await m.findOneBy(Order, { id: ev.orderId });
+      if (!order)
+        throw new NotFoundException(`Buyurtma topilmadi: #${ev.orderId}`);
+
+      const existing = await m.findOne(Payment, {
+        where: { external_id: ev.paymentId },
+        relations: { order: true },
+      });
+      if (existing && existing.order.id !== order.id) {
+        throw new ConflictException(
+          `To'lov ${ev.paymentId} boshqa buyurtmaga tegishli`,
+        );
+      }
+      let saved: Payment;
+      if (existing) {
+        existing.status = ev.status;
+        existing.amount = ev.amount;
+        saved = await m.save(existing);
+      } else {
+        saved = await m.save(
+          m.create(Payment, {
+            order,
+            external_id: ev.paymentId,
+            status: ev.status,
+            amount: ev.amount,
+          }),
+        );
+      }
+      return { payment: saved, total: order.total };
+    });
+
+    if (ev.status === 'PAID' && ev.amount !== total) {
+      this.log.warn(
+        `#${ev.orderId}: to'lov summasi ${ev.amount}, buyurtma summasi ${total} — tekshiring`,
+      );
+    }
+    this.log.log(`#${ev.orderId}: to'lov ${ev.paymentId} → ${ev.status}`);
+    // Tranzaksiya yopilgach — panelga xabar
+    this.live.orderChanged(ev.orderId, 'payment');
+    return payment;
+  }
+}
