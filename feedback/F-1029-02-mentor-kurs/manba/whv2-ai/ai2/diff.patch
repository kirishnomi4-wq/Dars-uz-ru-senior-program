index 0000000..e0321dd
--- /dev/null
+++ b/src/api/payment/payment-webhook.ts
@@ -0,0 +1,57 @@
+import { BadRequestException } from '@nestjs/common';
+import { createHmac, timingSafeEqual } from 'crypto';
+import type { PaymentStatus } from '../../core/entity';
+
+// To'lov xizmatidan kelgan xabar (JSON tana):
+//   { "payment_id": "P-1001", "order_id": 12, "status": "paid" | "rejected", "amount": 100000 }
+export interface PaymentEvent {
+  paymentId: string;
+  orderId: number;
+  status: PaymentStatus;
+  amount: number;
+}
+
+// X-Signature = HMAC-SHA256(kalit, xom tana) — hex. Tana JSON'ga aylantirilmasdan, baytma-bayt tekshiriladi.
+// Kalit bo'sh bo'lsa hech narsa tasdiqlanmaydi (sirtdan chiqqan xabar ham rad etiladi).
+export function verifySignature(
+  rawBody: Buffer | undefined,
+  signature: string | undefined,
+  secret: string,
+): boolean {
+  if (!rawBody || !secret || !signature) return false;
+  if (!/^[0-9a-fA-F]{64}$/.test(signature)) return false;
+  const expected = createHmac('sha256', secret).update(rawBody).digest();
+  return timingSafeEqual(expected, Buffer.from(signature, 'hex'));
+}
+
+const STATUS: Record<string, PaymentStatus> = {
+  paid: 'PAID',
+  rejected: 'REJECTED',
+};
+
+// Maydonlarni tekshiradi; noto'g'ri bo'lsa 400
+export function parsePaymentEvent(body: unknown): PaymentEvent {
+  const b = (body ?? {}) as Record<string, unknown>;
+  const rawId = b.payment_id;
+  const paymentId =
+    typeof rawId === 'string' || typeof rawId === 'number' ? String(rawId) : '';
+  const orderId = Number(b.order_id);
+  const status = typeof b.status === 'string' ? STATUS[b.status] : undefined;
+  const amount = b.amount;
+
+  if (!paymentId || paymentId.length > 100) {
+    throw new BadRequestException("payment_id noto'g'ri");
+  }
+  if (!Number.isInteger(orderId) || orderId <= 0) {
+    throw new BadRequestException("order_id noto'g'ri");
+  }
+  if (!status) {
+    throw new BadRequestException(
+      "status faqat 'paid' yoki 'rejected' bo'lishi kerak",
+    );
+  }
+  if (typeof amount !== 'number' || !Number.isInteger(amount) || amount < 0) {
+    throw new BadRequestException("amount noto'g'ri (butun son, so'm)");
+  }
+  return { paymentId, orderId, status, amount };
+}
