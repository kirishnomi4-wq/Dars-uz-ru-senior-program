@@ -0,0 +1,47 @@
+import { Injectable } from '@nestjs/common';
+import { Subject } from 'rxjs';
+import { Order, OrderStatus } from '../../core/entity';
+
+// Panelga (WebSocket) yuboriladigan buyurtma ko'rinishi — telegram_id va ichki maydonlarsiz
+export interface OrderView {
+  id: number;
+  status: OrderStatus;
+  total: number;
+  phone: string;
+  customer: string;
+  createdAt: string;
+  items: { name: string; qty: number; price: number }[];
+}
+
+// created — bot yangi buyurtma oldi; updated — admin holatini o'zgartirdi
+export interface OrderChange {
+  type: 'created' | 'updated';
+  order: OrderView;
+}
+
+export function toOrderView(o: Order): OrderView {
+  return {
+    id: o.id,
+    status: o.status,
+    total: o.total,
+    phone: o.phone,
+    customer: o.user?.name ?? '',
+    createdAt: (o.created_at ?? new Date()).toISOString(),
+    items: (o.items ?? []).map((i) => ({
+      name: i.product?.name ?? '',
+      qty: i.qty,
+      price: i.price,
+    })),
+  };
+}
+
+// Buyurtma o'zgarishlari oqimi. OrderService faqat TRANZAKSIYA COMMIT bo'lgandan keyin publish qiladi.
+@Injectable()
+export class OrderEvents {
+  private readonly subject = new Subject<OrderChange>();
+  readonly changes = this.subject.asObservable();
+
+  publish(change: OrderChange): void {
+    this.subject.next(change);
+  }
+}
