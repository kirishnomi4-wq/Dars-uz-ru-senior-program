index 0000000..fab77ad
--- /dev/null
+++ b/src/api/live/orders-panel.controller.ts
@@ -0,0 +1,29 @@
+import {
+  Controller,
+  Get,
+  Header,
+  Query,
+  ServiceUnavailableException,
+  UnauthorizedException,
+} from '@nestjs/common';
+import { config } from '../../config';
+import { panelTokenOk } from './panel-auth';
+import { ORDERS_PANEL_HTML } from './orders-panel';
+
+// Brauzerda: http://localhost:PORT/admin/orders?token=PANEL_TOKEN
+@Controller('admin')
+export class OrdersPanelController {
+  @Get('orders')
+  @Header('Content-Type', 'text/html; charset=utf-8')
+  @Header('Cache-Control', 'no-store')
+  page(@Query('token') token?: string): string {
+    if (!config.PANEL_TOKEN) {
+      throw new ServiceUnavailableException(
+        'PANEL_TOKEN .env da yo’q — panel yopiq',
+      );
+    }
+    if (!panelTokenOk(token))
+      throw new UnauthorizedException('token noto‘g‘ri');
+    return ORDERS_PANEL_HTML;
+  }
+}
diff --git a/src/api/live/orders-panel.ts b/src/api/live/orders-panel.ts
new file mode 100644
index 0000000..ced9c08
--- /dev/null
+++ b/src/api/live/orders-panel.ts
@@ -0,0 +1,137 @@
+// Admin paneli sahifasi. Tashqi kutubxona yo'q — brauzerning o'zi WebSocket ochadi.
+// Diqqat: bu yerda backtick va ${ ishlatilmaydi — buyurtma ma'lumoti textContent orqali qo'yiladi (XSS'dan himoya).
+export const ORDERS_PANEL_HTML = `<!doctype html>
+<html lang="uz">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>Buyurtmalar — jonli</title>
+<style>
+:root { --bg:#f6f7f9; --card:#ffffff; --text:#1d2330; --muted:#6b7385; --line:#e3e6ec; --ok:#16a34a; --bad:#dc2626; --hi:#facc15; }
+@media (prefers-color-scheme: dark) {
+  :root:not([data-theme="light"]) { --bg:#0f1218; --card:#181c25; --text:#e8ebf1; --muted:#9aa3b5; --line:#2a303d; }
+}
+:root[data-theme="dark"] { --bg:#0f1218; --card:#181c25; --text:#e8ebf1; --muted:#9aa3b5; --line:#2a303d; }
+body { margin:0; background:var(--bg); color:var(--text); font:15px/1.4 system-ui, -apple-system, sans-serif; }
+header { display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px; padding:16px; }
+h1 { margin:0; font-size:20px; }
+#conn { font-size:13px; color:var(--muted); }
+#conn.on { color:var(--ok); }
+#conn.off { color:var(--bad); }
+#list { display:grid; gap:12px; padding:0 16px 24px; grid-template-columns:repeat(auto-fill, minmax(260px, 1fr)); }
+.card { background:var(--card); border:1px solid var(--line); border-radius:12px; padding:14px; transition:box-shadow .3s; }
+.card.flash { box-shadow:0 0 0 3px var(--hi); }
+.top { display:flex; justify-content:space-between; align-items:center; gap:8px; }
+.num { font-weight:700; }
+.badge { font-size:12px; padding:2px 8px; border-radius:999px; color:#fff; white-space:nowrap; }
+.meta { color:var(--muted); font-size:13px; margin-top:6px; }
+ul { margin:8px 0 0; padding-left:18px; }
+.total { font-weight:700; margin-top:8px; }
+.empty { color:var(--muted); padding:8px 16px; }
+</style>
+</head>
+<body>
+<header>
+  <h1>Buyurtmalar — jonli</h1>
+  <span id="conn">ulanmoqda…</span>
+</header>
+<main id="list"></main>
+<script>
+(function () {
+  var token = new URLSearchParams(location.search).get('token') || '';
+  var orders = {};
+  var listEl = document.getElementById('list');
+  var connEl = document.getElementById('conn');
+  var retry = 1000;
+  var STATUS = { NEW: 'Yangi', CONFIRMED: 'Tasdiqlangan', DELIVERED: 'Yetkazilgan', CANCELLED: 'Bekor qilingan' };
+  var COLOR = { NEW: '#2563eb', CONFIRMED: '#16a34a', DELIVERED: '#0f766e', CANCELLED: '#dc2626' };
+
+  function som(n) { return Number(n).toLocaleString('ru-RU') + " so'm"; }
+
+  function el(tag, cls, text) {
+    var e = document.createElement(tag);
+    if (cls) e.className = cls;
+    if (text !== undefined) e.textContent = text;
+    return e;
+  }
+
+  function card(o) {
+    var c = el('article', 'card');
+    c.setAttribute('data-id', o.id);
+    var top = el('div', 'top');
+    top.appendChild(el('span', 'num', '#' + o.id));
+    var b = el('span', 'badge', STATUS[o.status] || o.status);
+    b.style.background = COLOR[o.status] || '#6b7385';
+    top.appendChild(b);
+    c.appendChild(top);
+    c.appendChild(el('div', 'meta', (o.customer || 'Mijoz') + ' · ' + (o.phone || '')));
+    c.appendChild(el('div', 'meta', new Date(o.createdAt).toLocaleString('uz-UZ')));
+    var ul = el('ul');
+    (o.items || []).forEach(function (i) {
+      ul.appendChild(el('li', '', i.name + ' × ' + i.qty));
+    });
+    c.appendChild(ul);
+    c.appendChild(el('div', 'total', 'Jami: ' + som(o.total)));
+    return c;
+  }
+
+  function render() {
+    listEl.textContent = '';
+    var ids = Object.keys(orders).map(Number).sort(function (a, b) { return b - a; });
+    if (ids.length === 0) {
+      listEl.appendChild(el('div', 'empty', 'Hozircha buyurtma yo’q.'));
+      return;
+    }
+    ids.forEach(function (id) { listEl.appendChild(card(orders[id])); });
+  }
+
+  function flash(id) {
+    var c = listEl.querySelector('[data-id="' + id + '"]');
+    if (!c) return;
+    c.classList.add('flash');
+    setTimeout(function () { c.classList.remove('flash'); }, 1600);
+  }
+
+  function setConn(on, text) {
+    connEl.className = on ? 'on' : 'off';
+    connEl.textContent = text;
+  }
+
+  function handle(m) {
+    if (m.type === 'snapshot') {
+      orders = {};
+      (m.orders || []).forEach(function (o) { orders[o.id] = o; });
+      render();
+      return;
+    }
+    if ((m.type === 'created' || m.type === 'updated') && m.order) {
+      orders[m.order.id] = m.order;
+      render();
+      flash(m.order.id);
+    }
+  }
+
+  function connect() {
+    var proto = location.protocol === 'https:' ? 'wss://' : 'ws://';
+    var ws = new WebSocket(proto + location.host + '/ws/orders?token=' + encodeURIComponent(token));
+    ws.onopen = function () { retry = 1000; setConn(true, 'jonli · ulangan'); };
+    ws.onmessage = function (e) {
+      var m;
+      try { m = JSON.parse(e.data); } catch (err) { return; }
+      handle(m);
+    };
+    ws.onclose = function (e) {
+      if (e.code === 1008) { setConn(false, 'token noto‘g‘ri yoki panel yopiq'); return; }
+      setConn(false, 'uzildi — qayta ulanmoqda…');
+      setTimeout(connect, retry);
+      retry = Math.min(retry * 2, 15000);
+    };
+  }
+
+  render();
+  connect();
+})();
+</script>
+</body>
+</html>
+`;
diff --git a/src/api/live/orders.gateway.ts b/src/api/live/orders.gateway.ts
new file mode 100644
index 0000000..ff5300a
--- /dev/null
+++ b/src/api/live/orders.gateway.ts
@@ -0,0 +1,78 @@
+import { Inject, OnModuleDestroy } from '@nestjs/common';
+import {
+  OnGatewayConnection,
+  WebSocketGateway,
+  WebSocketServer,
+} from '@nestjs/websockets';
+import type { IncomingMessage } from 'http';
+import { Subscription } from 'rxjs';
+import type { Server, WebSocket } from 'ws';
+import { OrderEvents, OrderView, toOrderView } from '../order/order-events';
+import { OrderService } from '../order/order.service';
+import { panelTokenOk } from './panel-auth';
+
+const OPEN = 1; // ws: WebSocket.OPEN
+const SNAPSHOT_SIZE = 50;
+
+// Admin paneli uchun: ulanganda oxirgi buyurtmalar ro'yxati (snapshot),
+// keyin har yangi yoki o'zgargan buyurtma — hammasiga bitta xabar.
+// Xabar turlari: {type:'snapshot', orders:[...]} · {type:'created'|'updated', order:{...}}
+@WebSocketGateway({ path: '/ws/orders' })
+export class OrdersGateway implements OnGatewayConnection, OnModuleDestroy {
+  @WebSocketServer() private server: Server;
+
+  // Snapshot hali yuborilmagan klientlar: shu paytdagi o'zgarishlar navbatda turadi
+  private readonly waiting = new Map<WebSocket, string[]>();
+  private readonly sub: Subscription;
+
+  constructor(
+    @Inject(OrderService) private readonly orders: OrderService,
+    events: OrderEvents,
+  ) {
+    this.sub = events.changes.subscribe((change) => {
+      this.broadcast(JSON.stringify(change));
+    });
+  }
+
+  onModuleDestroy() {
+    this.sub.unsubscribe();
+  }
+
+  async handleConnection(client: WebSocket, req: IncomingMessage) {
+    const token = new URL(req.url ?? '/', 'http://localhost').searchParams.get(
+      'token',
+    );
+    if (!panelTokenOk(token)) {
+      client.close(1008, 'token');
+      return;
+    }
+
+    // Snapshot o'qilayotganda kelgan o'zgarishlar navbatga olinadi, keyin yuboriladi
+    // (aks holda eski snapshot yangi o'zgarishni ustidan yozib qo'yishi mumkin)
+    const queue: string[] = [];
+    this.waiting.set(client, queue);
+    client.on('close', () => this.waiting.delete(client));
+
+    try {
+      const rows = await this.orders.recent(SNAPSHOT_SIZE);
+      const orders: OrderView[] = rows.map(toOrderView);
+      this.waiting.delete(client);
+      if (client.readyState !== OPEN) return;
+      client.send(JSON.stringify({ type: 'snapshot', orders }));
+      for (const msg of queue) client.send(msg);
+    } catch (e) {
+      this.waiting.delete(client);
+      console.error('Panel snapshot xatosi:', (e as Error).message);
+      client.close(1011, 'snapshot');
+    }
+  }
+
+  private broadcast(msg: string) {
+    for (const client of this.server?.clients ?? []) {
+      if (client.readyState !== OPEN) continue;
+      const queue = this.waiting.get(client);
+      if (queue) queue.push(msg);
+      else client.send(msg);
+    }
+  }
+}
diff --git a/src/api/live/panel-auth.ts b/src/api/live/panel-auth.ts
new file mode 100644
index 0000000..b67aaa4
--- /dev/null
+++ b/src/api/live/panel-auth.ts
@@ -0,0 +1,11 @@
+import { timingSafeEqual } from 'crypto';
+import { config } from '../../config';
+
+// Panel tokeni .env dagi PANEL_TOKEN bilan mos bo'lsagina o'tadi. PANEL_TOKEN bo'sh bo'lsa hech kim kirmaydi.
+export function panelTokenOk(given: string | null | undefined): boolean {
+  const expected = config.PANEL_TOKEN;
+  if (!expected || !given) return false;
+  const a = Buffer.from(given);
+  const b = Buffer.from(expected);
+  return a.length === b.length && timingSafeEqual(a, b);
+}
