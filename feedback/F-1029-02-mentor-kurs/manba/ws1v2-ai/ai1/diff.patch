@@ -0,0 +1,240 @@
+// GET /admin — jonli buyurtmalar paneli. Bitta sahifa, tashqi kutubxonasiz (CDN yo'q).
+// Sahifada sir yo'q: kalitni admin o'zi kiritadi (yoki /admin#token=... havolasi),
+// u faqat shu brauzer oynasida (sessionStorage) turadi va WebSocket ulanishida tekshiriladi.
+// Mijoz ismi Telegram'dan keladi — sahifaga faqat textContent bilan yoziladi (innerHTML emas).
+export const PANEL_HTML = /* html */ `<!doctype html>
+<html lang="uz">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>Buyurtmalar — OrderBotNest</title>
+<style>
+  :root { --bg:#f5f6f8; --card:#fff; --text:#1d2330; --muted:#6b7385; --line:#e3e6ec;
+          --new:#2563eb; --ok:#16a34a; --done:#7c3aed; --cancel:#dc2626; --flash:#fff7d6; }
+  @media (prefers-color-scheme: dark) {
+    :root { --bg:#12151b; --card:#1b1f27; --text:#e7eaf0; --muted:#98a0b3; --line:#2b313d; --flash:#3a3317; }
+  }
+  * { box-sizing: border-box; }
+  body { margin:0; background:var(--bg); color:var(--text);
+         font:15px/1.45 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
+  header { display:flex; align-items:center; gap:12px; padding:14px 20px;
+           background:var(--card); border-bottom:1px solid var(--line); position:sticky; top:0; }
+  h1 { font-size:18px; margin:0; flex:1; }
+  .conn { font-size:13px; color:var(--muted); display:flex; align-items:center; gap:6px; }
+  .dot { width:9px; height:9px; border-radius:50%; background:#9ca3af; }
+  .conn.on .dot { background:var(--ok); }
+  .conn.off .dot { background:var(--cancel); }
+  main { max-width:1100px; margin:0 auto; padding:16px; }
+  .counts { display:flex; flex-wrap:wrap; gap:8px; margin-bottom:12px; font-size:13px; color:var(--muted); }
+  .counts b { color:var(--text); }
+  table { width:100%; border-collapse:collapse; background:var(--card);
+          border:1px solid var(--line); border-radius:10px; overflow:hidden; }
+  th, td { text-align:left; padding:10px 12px; border-bottom:1px solid var(--line); vertical-align:top; }
+  th { font-size:12px; text-transform:uppercase; letter-spacing:.04em; color:var(--muted); }
+  tr:last-child td { border-bottom:0; }
+  td.num { white-space:nowrap; font-variant-numeric:tabular-nums; }
+  .items { margin:0; padding:0; list-style:none; color:var(--muted); font-size:13px; }
+  .badge { display:inline-block; padding:2px 8px; border-radius:999px; font-size:12px;
+           font-weight:600; color:#fff; white-space:nowrap; }
+  .s-NEW { background:var(--new); } .s-CONFIRMED { background:var(--ok); }
+  .s-DELIVERED { background:var(--done); } .s-CANCELLED { background:var(--cancel); }
+  tr.flash td { animation: flash 2.5s ease-out; }
+  @keyframes flash { from { background:var(--flash); } to { background:transparent; } }
+  @media (prefers-reduced-motion: reduce) { tr.flash td { animation:none; background:var(--flash); } }
+  .empty { padding:32px; text-align:center; color:var(--muted); }
+  .login { max-width:380px; margin:60px auto; background:var(--card); padding:24px;
+           border:1px solid var(--line); border-radius:10px; }
+  .login input { width:100%; padding:10px; font:inherit; margin:8px 0 12px;
+                 border:1px solid var(--line); border-radius:8px; background:var(--bg); color:var(--text); }
+  .login button { padding:10px 16px; font:inherit; border:0; border-radius:8px; background:var(--new); color:#fff; cursor:pointer; }
+  .err { color:var(--cancel); font-size:13px; min-height:1.4em; }
+  .hidden { display:none; }
+  @media (max-width:700px) {
+    thead { display:none; }
+    tr { display:block; border-bottom:1px solid var(--line); padding:8px 0; }
+    td { display:block; border:0; padding:3px 12px; }
+  }
+</style>
+</head>
+<body>
+<header>
+  <h1>Buyurtmalar</h1>
+  <span id="conn" class="conn"><span class="dot"></span><span id="connText">ulanmoqda…</span></span>
+</header>
+
+<form id="login" class="login hidden">
+  <label for="token">Panel kaliti (.env dagi ADMIN_PANEL_TOKEN):</label>
+  <input id="token" type="password" autocomplete="off" required>
+  <div id="loginErr" class="err"></div>
+  <button type="submit">Kirish</button>
+</form>
+
+<main id="panel" class="hidden">
+  <div id="counts" class="counts"></div>
+  <table>
+    <thead><tr><th>#</th><th>Vaqt</th><th>Mijoz</th><th>Telefon</th><th>Mahsulotlar</th><th>Jami</th><th>Status</th></tr></thead>
+    <tbody id="rows"></tbody>
+  </table>
+  <div id="empty" class="empty hidden">Hozircha buyurtma yo'q. Bot yangi buyurtma olishi bilan shu yerda chiqadi.</div>
+</main>
+
+<script>
+(function () {
+  var KEY = 'orderbot.panelToken';
+  var MAX_ROWS = 100;
+  var STATUS_ORDER = ['NEW', 'CONFIRMED', 'DELIVERED', 'CANCELLED'];
+  var orders = new Map();
+  var labels = {};
+  var ws = null, retry = 0, retryTimer = null;
+  var $ = function (id) { return document.getElementById(id); };
+
+  // /admin#token=... — kalit havoladan olinadi va manzil satridan darhol o'chiriladi
+  function tokenFromHash() {
+    var m = location.hash.match(/token=([^&]+)/);
+    if (!m) return false;
+    try { sessionStorage.setItem(KEY, decodeURIComponent(m[1])); } catch (e) {}
+    history.replaceState(null, '', location.pathname);
+    return true;
+  }
+  tokenFromHash();
+  // Ochiq sahifaga yangi havola qo'yilsa brauzer qayta yuklamaydi — o'zimiz qayta ulanamiz
+  window.addEventListener('hashchange', function () {
+    if (!tokenFromHash()) return;
+    if (ws) { ws.onclose = null; ws.close(); ws = null; }
+    connect();
+  });
+  function getToken() { try { return sessionStorage.getItem(KEY) || ''; } catch (e) { return ''; } }
+  function setToken(t) { try { t ? sessionStorage.setItem(KEY, t) : sessionStorage.removeItem(KEY); } catch (e) {} }
+
+  function setConn(state, text) {
+    $('conn').className = 'conn ' + state;
+    $('connText').textContent = text;
+  }
+
+  function showLogin(err) {
+    $('panel').classList.add('hidden');
+    $('login').classList.remove('hidden');
+    $('loginErr').textContent = err || '';
+    setConn('off', 'ulanmagan');
+    $('token').focus();
+  }
+
+  $('login').addEventListener('submit', function (e) {
+    e.preventDefault();
+    setToken($('token').value.trim());
+    $('token').value = '';
+    connect();
+  });
+
+  function som(n) { return Number(n).toLocaleString('ru-RU') + " so'm"; }
+  function time(iso) {
+    if (!iso) return '';
+    var d = new Date(iso);
+    return d.toLocaleDateString('ru-RU') + ' ' + d.toLocaleTimeString('ru-RU', { hour: '2-digit', minute: '2-digit' });
+  }
+  function td(text, cls) {
+    var c = document.createElement('td');
+    if (cls) c.className = cls;
+    if (text != null) c.textContent = text;
+    return c;
+  }
+
+  function row(o, flash) {
+    var tr = document.createElement('tr');
+    tr.dataset.id = o.id;
+    if (flash) tr.className = 'flash';
+    tr.appendChild(td('#' + o.id, 'num'));
+    tr.appendChild(td(time(o.createdAt), 'num'));
+    tr.appendChild(td(o.customer));
+    tr.appendChild(td(o.phone, 'num'));
+    var cell = td(null), ul = document.createElement('ul');
+    ul.className = 'items';
+    o.items.forEach(function (i) {
+      var li = document.createElement('li');
+      li.textContent = i.name + ' × ' + i.qty;
+      ul.appendChild(li);
+    });
+    cell.appendChild(ul);
+    tr.appendChild(cell);
+    tr.appendChild(td(som(o.total), 'num'));
+    var st = td(null), b = document.createElement('span');
+    b.className = 'badge s-' + o.status;
+    b.textContent = o.statusText;
+    st.appendChild(b);
+    tr.appendChild(st);
+    return tr;
+  }
+
+  function render(flashId) {
+    var list = Array.from(orders.values()).sort(function (a, b) { return b.id - a.id; });
+    var tbody = $('rows');
+    tbody.textContent = '';
+    list.forEach(function (o) { tbody.appendChild(row(o, o.id === flashId)); });
+    $('empty').classList.toggle('hidden', list.length > 0);
+
+    var c = {};
+    list.forEach(function (o) { c[o.status] = (c[o.status] || 0) + 1; });
+    var box = $('counts');
+    box.textContent = '';
+    STATUS_ORDER.forEach(function (s) {
+      var span = document.createElement('span');
+      span.textContent = (labels[s] || s) + ': ';
+      var bold = document.createElement('b');
+      bold.textContent = String(c[s] || 0);
+      span.appendChild(bold);
+      box.appendChild(span);
+    });
+    var fresh = c.NEW || 0;
+    document.title = (fresh ? '(' + fresh + ') ' : '') + 'Buyurtmalar — OrderBotNest';
+  }
+
+  function onMessage(ev) {
+    var msg;
+    try { msg = JSON.parse(ev.data); } catch (e) { return; }
+    if (msg.event === 'snapshot') {
+      labels = msg.data.statuses || {};
+      orders = new Map();
+      msg.data.orders.forEach(function (o) { orders.set(o.id, o); });
+      render();
+    } else if (msg.event === 'order') {
+      var o = msg.data.order;
+      orders.set(o.id, o);
+      if (orders.size > MAX_ROWS) {
+        var oldest = Math.min.apply(null, Array.from(orders.keys()));
+        orders.delete(oldest);
+      }
+      render(o.id);
+    }
+  }
+
+  function connect() {
+    clearTimeout(retryTimer);
+    var token = getToken();
+    if (!token) return showLogin();
+    $('login').classList.add('hidden');
+    $('panel').classList.remove('hidden');
+    setConn('', 'ulanmoqda…');
+    var proto = location.protocol === 'https:' ? 'wss://' : 'ws://';
+    ws = new WebSocket(proto + location.host + '/admin/ws?token=' + encodeURIComponent(token));
+    ws.onopen = function () { retry = 0; setConn('on', 'jonli'); };
+    ws.onmessage = onMessage;
+    ws.onclose = function (ev) {
+      ws = null;
+      if (ev.code === 4401) { setToken(''); return showLogin("Kalit noto'g'ri."); }
+      if (ev.code === 4403) {
+        setConn('off', 'panel yopiq');
+        return showLogin("Serverda ADMIN_PANEL_TOKEN sozlanmagan (.env).");
+      }
+      // Server qayta ishga tushdi yoki internet uzildi — o'zi qayta ulanadi, snapshot yangidan keladi
+      var wait = Math.min(15000, 1000 * Math.pow(2, retry++));
+      setConn('off', 'uzildi — ' + Math.round(wait / 1000) + ' s dan keyin qayta ulanadi');
+      retryTimer = setTimeout(connect, wait);
+    };
+  }
+
+  connect();
+})();
+</script>
+</body>
+</html>
+`;
