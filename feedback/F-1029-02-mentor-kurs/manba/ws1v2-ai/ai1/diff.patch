@@ -0,0 +1,142 @@
+import { Inject, Logger, OnModuleDestroy, OnModuleInit } from '@nestjs/common';
+import {
+  OnGatewayConnection,
+  OnGatewayDisconnect,
+  WebSocketGateway,
+} from '@nestjs/websockets';
+import { createHash, timingSafeEqual } from 'crypto';
+import { IncomingMessage } from 'http';
+import { Subscription } from 'rxjs';
+import { WebSocket } from 'ws';
+import { OrderEvents } from '../order/order-events';
+import { OrderService } from '../order/order.service';
+import { STATUS_UZ } from '../telegram/texts';
+import { toOrderView } from './order-view';
+
+export const ADMIN_PANEL_TOKEN = Symbol('ADMIN_PANEL_TOKEN');
+export const SNAPSHOT_LIMIT = 30; // panel ochilganda oxirgi nechta buyurtma ko'rsatiladi
+const PING_MS = 30_000; // uzilib qolgan brauzerlarni topish uchun
+
+// Yopilish kodlari (4000–4999 — ilovaning o'zi uchun ajratilgan oraliq)
+export const CLOSE_BAD_TOKEN = 4401;
+export const CLOSE_PANEL_OFF = 4403;
+
+// pending — snapshot hali yuborilmagan: shu orada kelgan o'zgarishlar navbatda turadi,
+// snapshot'dan KEYIN yuboriladi (aks holda eskirgan snapshot yangi statusni bosib ketardi)
+type PanelSocket = WebSocket & { alive?: boolean; pending?: string[] };
+
+const sha256 = (s: string) => createHash('sha256').update(s).digest();
+// Ikkala satr ham sha256 dan o'tadi — uzunligi teng, solishtirish vaqti kalitni oshkor qilmaydi
+const sameToken = (a: string, b: string) =>
+  timingSafeEqual(sha256(a), sha256(b));
+
+// Jonli buyurtmalar paneli: ws://<host>/admin/ws?token=...
+// Ulanganda — oxirgi buyurtmalar (snapshot), keyin har o'zgarish (order) darhol.
+// Xabarlar: { event: 'snapshot', data: { orders, statuses } } · { event: 'order', data: { kind, order } }
+@WebSocketGateway({ path: '/admin/ws' })
+export class AdminPanelGateway
+  implements
+    OnGatewayConnection,
+    OnGatewayDisconnect,
+    OnModuleInit,
+    OnModuleDestroy
+{
+  private readonly log = new Logger('AdminPanel');
+  // Faqat kalitdan o'tganlar — ulanib, hali tekshirilmaganlarga hech narsa ketmaydi
+  private readonly clients = new Set<PanelSocket>();
+  private sub?: Subscription;
+  private pinger?: NodeJS.Timeout;
+
+  constructor(
+    private readonly orders: OrderService,
+    private readonly events: OrderEvents,
+    @Inject(ADMIN_PANEL_TOKEN) private readonly token: string,
+  ) {}
+
+  onModuleInit() {
+    if (!this.token) {
+      this.log.warn(
+        "ADMIN_PANEL_TOKEN bo'sh — /admin paneli yopiq (.env ga kalit yozing, README)",
+      );
+    }
+    this.sub = this.events.stream.subscribe(({ kind, order }) => {
+      // Panel xatosi buyurtma oqimini (bot javobini) hech qachon buzmasin
+      try {
+        this.broadcast('order', { kind, order: toOrderView(order) });
+      } catch (e) {
+        this.log.error(`Panelga yuborilmadi: ${(e as Error).message}`);
+      }
+    });
+    this.pinger = setInterval(() => this.ping(), PING_MS);
+    this.pinger.unref();
+  }
+
+  onModuleDestroy() {
+    this.sub?.unsubscribe();
+    clearInterval(this.pinger);
+    for (const c of this.clients) c.close(1001, 'server stopped');
+    this.clients.clear();
+  }
+
+  async handleConnection(client: PanelSocket, req: IncomingMessage) {
+    if (!this.token) {
+      return client.close(CLOSE_PANEL_OFF, 'ADMIN_PANEL_TOKEN is not set');
+    }
+    const given =
+      new URL(req.url ?? '', 'http://x').searchParams.get('token') ?? '';
+    if (!sameToken(given, this.token)) {
+      return client.close(CLOSE_BAD_TOKEN, 'bad token');
+    }
+    client.alive = true;
+    client.on('pong', () => (client.alive = true));
+    client.pending = [];
+    this.clients.add(client);
+    try {
+      const list = await this.orders.recent(SNAPSHOT_LIMIT);
+      this.send(client, 'snapshot', {
+        orders: list.map(toOrderView),
+        statuses: STATUS_UZ, // hisoblagich yorliqlari (bot bilan bir xil matn)
+      });
+      const queued = client.pending;
+      client.pending = undefined;
+      for (const msg of queued) this.sendRaw(client, msg);
+    } catch (e) {
+      this.log.error(`Snapshot o'qilmadi: ${(e as Error).message}`);
+      this.clients.delete(client);
+      client.close(1011, 'database error');
+    }
+  }
+
+  handleDisconnect(client: PanelSocket) {
+    this.clients.delete(client);
+  }
+
+  private broadcast(event: string, data: unknown) {
+    const msg = JSON.stringify({ event, data });
+    for (const c of this.clients) {
+      if (c.pending) c.pending.push(msg);
+      else this.sendRaw(c, msg);
+    }
+  }
+
+  private send(client: WebSocket, event: string, data: unknown) {
+    this.sendRaw(client, JSON.stringify({ event, data }));
+  }
+
+  private sendRaw(client: WebSocket, msg: string) {
+    if (client.readyState === WebSocket.OPEN) client.send(msg);
+  }
+
+  // Wi-Fi uzilsa brauzer «yopildi» demaydi — ping'ga javob bermaganini uzamiz
+  private ping() {
+    for (const c of this.clients) {
+      if (!c.alive) {
+        this.clients.delete(c);
+        c.terminate();
+        continue;
+      }
+      c.alive = false;
+      c.ping();
+    }
+  }
+}
