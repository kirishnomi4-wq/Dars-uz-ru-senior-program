+import { Module } from '@nestjs/common';
+import { config } from '../../config';
+import { OrderModule } from '../order/order.module';
+import { AdminPanelController } from './admin-panel.controller';
+import { ADMIN_PANEL_TOKEN, AdminPanelGateway } from './admin-panel.gateway';
+
+// Jonli buyurtmalar paneli: GET /admin (sahifa) + ws /admin/ws (o'zgarishlar)
+@Module({
+  imports: [OrderModule],
+  controllers: [AdminPanelController],
+  providers: [
+    AdminPanelGateway,
+    { provide: ADMIN_PANEL_TOKEN, useValue: config.ADMIN_PANEL_TOKEN },
+  ],
+})
+export class AdminPanelModule {}
