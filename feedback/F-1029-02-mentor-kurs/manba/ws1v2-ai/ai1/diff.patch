new file mode 100644
index 0000000..0f200f1
--- /dev/null
+++ b/src/api/admin-panel/admin-panel.gateway.spec.ts
@@ -0,0 +1,165 @@
+import { INestApplication } from '@nestjs/common';
+import { WsAdapter } from '@nestjs/platform-ws';
+import { Test } from '@nestjs/testing';
+import request from 'supertest';
+import { WebSocket } from 'ws';
+import { Order } from '../../core/entity';
+import { OrderEvents } from '../order/order-events';
+import { OrderService } from '../order/order.service';
+import { AdminPanelController } from './admin-panel.controller';
+import {
+  ADMIN_PANEL_TOKEN,
+  AdminPanelGateway,
+  CLOSE_BAD_TOKEN,
+  CLOSE_PANEL_OFF,
+} from './admin-panel.gateway';
+
+// Haqiqiy HTTP + WebSocket server (tasodifiy port), baza o'rniga soxta OrderService.recent
+const order = (id: number, status: Order['status'] = 'NEW') =>
+  ({
+    id,
+    phone: '+998901234567',
+    total: 100000,
+    status,
+    created_at: new Date('2026-11-04T10:00:00Z'),
+    user: { name: 'Aziza', telegram_id: '5123456789' },
+    items: [{ qty: 2, price: 50000, product: { name: 'Kolonka' } }],
+  }) as unknown as Order;
+
+const recent = jest.fn();
+
+async function start(token: string) {
+  const mod = await Test.createTestingModule({
+    controllers: [AdminPanelController],
+    providers: [
+      AdminPanelGateway,
+      OrderEvents,
+      { provide: OrderService, useValue: { recent } },
+      { provide: ADMIN_PANEL_TOKEN, useValue: token },
+    ],
+  })
+    .setLogger({ log() {}, error() {}, warn() {} })
+    .compile();
+  const app = mod.createNestApplication();
+  app.useWebSocketAdapter(new WsAdapter(app));
+  await app.listen(0);
+  const port = (app.getHttpServer().address() as { port: number }).port;
+  return { app, port, events: app.get(OrderEvents) };
+}
+
+// Ulanadi va kelgan xabarlarni yig'adi; yopilsa — kodini yozib qo'yadi
+function connect(port: number, token: string) {
+  const ws = new WebSocket(`ws://127.0.0.1:${port}/admin/ws?token=${token}`);
+  const msgs: { event: string; data: any }[] = [];
+  const closed = new Promise<number>((r) => ws.on('close', (code) => r(code)));
+  ws.on('message', (b) => msgs.push(JSON.parse(String(b))));
+  const waitFor = async (n: number) => {
+    for (let i = 0; i < 100 && msgs.length < n; i++)
+      await new Promise((r) => setTimeout(r, 10));
+    return msgs;
+  };
+  return { ws, msgs, closed, waitFor };
+}
+
+describe('Admin panel WebSocket', () => {
+  let app: INestApplication;
+  let port: number;
+  let events: OrderEvents;
+
+  beforeAll(async () => {
+    ({ app, port, events } = await start('sir-kalit'));
+  });
+  afterAll(() => app.close());
+  beforeEach(() => {
+    recent.mockReset();
+    recent.mockResolvedValue([order(2), order(1, 'CONFIRMED')]);
+  });
+
+  it('GET /admin — HTML sahifa', async () => {
+    const res = await request(app.getHttpServer()).get('/admin');
+    expect(res.status).toBe(200);
+    expect(res.headers['content-type']).toMatch(/text\/html/);
+    expect(res.text).toContain('/admin/ws');
+    expect(res.text).not.toContain('sir-kalit'); // kalit sahifaga tushmaydi
+  });
+
+  it("kalit noto'g'ri — 4401 bilan yopiladi, buyurtma ketmaydi", async () => {
+    const c = connect(port, 'boshqa');
+    expect(await c.closed).toBe(CLOSE_BAD_TOKEN);
+    expect(c.msgs).toEqual([]);
+    expect(recent).not.toHaveBeenCalled();
+  });
+
+  it('ulanganda — snapshot (oxirgi buyurtmalar)', async () => {
+    const c = connect(port, 'sir-kalit');
+    const [m] = await c.waitFor(1);
+    expect(m.event).toBe('snapshot');
+    expect(m.data.orders.map((o: any) => o.id)).toEqual([2, 1]);
+    expect(m.data.statuses.DELIVERED).toBe('🚚 Yetkazilgan');
+    expect(m.data.orders[0]).toEqual({
+      id: 2,
+      customer: 'Aziza',
+      phone: '+998901234567',
+      total: 100000,
+      status: 'NEW',
+      statusText: '🆕 Yangi',
+      createdAt: '2026-11-04T10:00:00.000Z',
+      items: [{ name: 'Kolonka', qty: 2, price: 50000 }],
+    });
+    expect(JSON.stringify(m)).not.toContain('5123456789'); // telegram_id panelga chiqmaydi
+    c.ws.close();
+  });
+
+  it("yangi buyurtma va status o'zgarishi — barcha ochiq panellarga darhol", async () => {
+    const a = connect(port, 'sir-kalit');
+    const b = connect(port, 'sir-kalit');
+    await a.waitFor(1);
+    await b.waitFor(1);
+    events.emit('created', order(3));
+    events.emit('updated', order(3, 'DELIVERED'));
+    for (const c of [a, b]) {
+      const msgs = await c.waitFor(3);
+      expect(msgs.slice(1)).toMatchObject([
+        {
+          event: 'order',
+          data: { kind: 'created', order: { id: 3, status: 'NEW' } },
+        },
+        {
+          event: 'order',
+          data: { kind: 'updated', order: { id: 3, status: 'DELIVERED' } },
+        },
+      ]);
+      c.ws.close();
+    }
+  });
+
+  it("snapshot o'qilayotganda kelgan o'zgarish yo'qolmaydi (snapshot'dan keyin keladi)", async () => {
+    let release!: () => void;
+    recent.mockImplementation(
+      () =>
+        new Promise((r) => {
+          release = () => r([order(5)]); // baza "sekin": eski holat — NEW
+        }),
+    );
+    const c = connect(port, 'sir-kalit');
+    await new Promise((r) => c.ws.on('open', r));
+    for (let i = 0; i < 50 && !release; i++)
+      await new Promise((r) => setTimeout(r, 10));
+    events.emit('updated', order(5, 'CONFIRMED')); // snapshot hali yo'lda
+    release();
+    const msgs = await c.waitFor(2);
+    expect(msgs.map((m) => m.event)).toEqual(['snapshot', 'order']);
+    expect(msgs[1].data.order.status).toBe('CONFIRMED');
+    c.ws.close();
+  });
+});
+
+describe("Admin panel: ADMIN_PANEL_TOKEN bo'sh", () => {
+  it('panel yopiq — har qanday ulanish 4403', async () => {
+    const { app, port } = await start('');
+    const c = connect(port, '');
+    expect(await c.closed).toBe(CLOSE_PANEL_OFF);
+    expect(c.msgs).toEqual([]);
+    await app.close();
+  });
+});
