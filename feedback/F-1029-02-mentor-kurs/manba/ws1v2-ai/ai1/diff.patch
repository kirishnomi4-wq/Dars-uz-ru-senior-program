+import { Injectable } from '@nestjs/common';
+import { Observable, Subject } from 'rxjs';
+import { Order } from '../../core/entity';
+
+// created — bot yangi buyurtma oldi; updated — status o'zgardi (tasdiq, yetkazildi, bekor)
+export type OrderEventKind = 'created' | 'updated';
+
+export interface OrderEvent {
+  kind: OrderEventKind;
+  order: Order;
+}
+
+// Buyurtma o'zgarishlari shu yerdan tarqaladi. OrderService faqat e'lon qiladi,
+// kim tinglayotganini bilmaydi (hozir — admin panel WebSocket'i).
+@Injectable()
+export class OrderEvents {
+  private readonly subject = new Subject<OrderEvent>();
+
+  readonly stream: Observable<OrderEvent> = this.subject.asObservable();
+
+  emit(kind: OrderEventKind, order: Order) {
+    this.subject.next({ kind, order });
+  }
+}
