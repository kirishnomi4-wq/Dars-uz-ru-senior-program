@@ -0,0 +1,33 @@
+import { Order } from '../../core/entity';
+import { STATUS_UZ } from '../telegram/texts';
+
+// Panelga ketadigan buyurtma ko'rinishi: faqat kerakli maydonlar.
+// Entity'ni o'zini yubormaymiz — unda telegram_id, state kabi ichki maydonlar
+// va order ↔ items aylana bog'lanishi bor (JSON.stringify yiqiladi).
+export interface OrderView {
+  id: number;
+  customer: string;
+  phone: string;
+  total: number;
+  status: Order['status'];
+  statusText: string;
+  createdAt: string | null;
+  items: { name: string; qty: number; price: number }[];
+}
+
+export function toOrderView(o: Order): OrderView {
+  return {
+    id: o.id,
+    customer: o.user?.name ?? '—',
+    phone: o.phone,
+    total: o.total,
+    status: o.status,
+    statusText: STATUS_UZ[o.status] ?? o.status,
+    createdAt: o.created_at ? new Date(o.created_at).toISOString() : null,
+    items: (o.items ?? []).map((i) => ({
+      name: i.product?.name ?? '—',
+      qty: i.qty,
+      price: i.price,
+    })),
+  };
+}
diff --git a/src/api/admin-panel/panel.html.ts b/src/api/admin-panel/panel.html.ts
