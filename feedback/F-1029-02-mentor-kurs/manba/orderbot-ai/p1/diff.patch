@@ -0,0 +1,42 @@
+import dataSource from './data-source';
+
+// Boshlang'ich katalog. Ikkinchi marta yurganda takror qo'shilmaydi:
+// name takrorlanmas (UNIQUE), shuning uchun ON CONFLICT (name) DO NOTHING.
+const PRODUCTS = [
+  { name: 'Klaviatura', price: 120000, stock: 8 },
+  { name: 'Sichqoncha', price: 75000, stock: 15 },
+  { name: 'Quloqchin', price: 95000, stock: 5 },
+  { name: 'Kolonka', price: 50000, stock: 10 },
+  { name: 'Planshet', price: 300000, stock: 3 },
+  { name: "O'yinchoq", price: 30000, stock: 4 },
+];
+
+async function seed() {
+  await dataSource.initialize();
+  try {
+    // Toza bazada jadval hali yo'q bo'lishi mumkin — avval migratsiyalar
+    await dataSource.runMigrations();
+
+    let added = 0;
+    for (const p of PRODUCTS) {
+      const rows: unknown[] = await dataSource.query(
+        `INSERT INTO "products" ("name", "price", "stock")
+         VALUES ($1, $2, $3)
+         ON CONFLICT ("name") DO NOTHING
+         RETURNING "id"`,
+        [p.name, p.price, p.stock],
+      );
+      added += rows.length;
+    }
+    console.log(
+      `Seed: ${added} ta mahsulot qo'shildi, ${PRODUCTS.length - added} tasi bazada bor edi.`,
+    );
+  } finally {
+    await dataSource.destroy();
+  }
+}
+
+seed().catch((e: Error) => {
+  console.error('Seed xatosi:', e.message);
+  process.exit(1);
+});
