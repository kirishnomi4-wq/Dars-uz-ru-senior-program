+import { join } from 'path';
+import { DataSourceOptions } from 'typeorm';
+import { config } from '../config';
+import { ProductEntity } from '../api/catalog/product.entity';
+
+if (!config.DATABASE_URL) {
+  throw new Error(
+    'DATABASE_URL topilmadi. .env ga yozing: DATABASE_URL=postgresql://postgres:parol@localhost:5432/shop',
+  );
+}
+
+const MIGRATION_EXT = __filename.endsWith('.ts') ? 'ts' : 'js';
+
+// Bitta sozlama: server (AppModule), seed va typeorm CLI uchun
+export const typeormOptions: DataSourceOptions = {
+  type: 'postgres',
+  url: config.DATABASE_URL,
+  entities: [ProductEntity],
+  // ts-node (seed, CLI) — .ts; `nest build` dan keyin dist/ — faqat .js
+  // (*.{ts,js} dist/ dagi .d.ts fayllarni ham ushlab olardi)
+  migrations: [join(__dirname, 'migrations', `*.${MIGRATION_EXT}`)],
+  migrationsTableName: 'migrations',
+  // Jadvallarni faqat migratsiya o'zgartiradi
+  synchronize: false,
+  // Server ko'tarilganda yurmagan migratsiyalar o'zi yuradi
+  migrationsRun: true,
+};
