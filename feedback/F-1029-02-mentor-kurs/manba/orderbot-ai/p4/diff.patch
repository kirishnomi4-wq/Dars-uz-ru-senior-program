+import {
+  Check,
+  Column,
+  Entity,
+  JoinColumn,
+  ManyToOne,
+  PrimaryGeneratedColumn,
+  Unique,
+} from 'typeorm';
+import { ProductEntity } from '../catalog/product.entity';
+import { OrderEntity } from './order.entity';
+
+// order_items jadvali: buyurtmadagi har mahsulot, buyurtma paytidagi narx bilan
+@Entity({ name: 'order_items' })
+@Unique('UQ_order_items_order_product', ['orderId', 'productId'])
+@Check('CHK_order_items_qty', '"qty" > 0')
+@Check('CHK_order_items_price', '"price" >= 0')
+export class OrderItemEntity {
+  @PrimaryGeneratedColumn()
+  id: number;
+
+  @Column({ name: 'order_id', type: 'integer' })
+  orderId: number;
+
+  @Column({ name: 'product_id', type: 'integer' })
+  productId: number;
+
+  @Column({ type: 'integer' })
+  qty: number;
+
+  @Column({ type: 'integer' })
+  price: number; // so'm, buyurtma paytidagi narx
+
+  @ManyToOne(() => OrderEntity, (o) => o.items, { onDelete: 'CASCADE' })
+  @JoinColumn({
+    name: 'order_id',
+    foreignKeyConstraintName: 'FK_order_items_order',
+  })
+  order?: OrderEntity;
+
+  @ManyToOne(() => ProductEntity, { onDelete: 'RESTRICT' })
+  @JoinColumn({
+    name: 'product_id',
+    foreignKeyConstraintName: 'FK_order_items_product',
+  })
+  product?: ProductEntity;
+}
