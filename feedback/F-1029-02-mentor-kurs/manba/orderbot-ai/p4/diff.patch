+import {
+  Check,
+  Column,
+  CreateDateColumn,
+  Entity,
+  Index,
+  JoinColumn,
+  ManyToOne,
+  OneToMany,
+  PrimaryGeneratedColumn,
+} from 'typeorm';
+import type { OrderStatus } from '../../core/types';
+import { bigintToNumber } from '../../database/bigint.transformer';
+import { UserEntity } from '../user/user.entity';
+import { OrderItemEntity } from './order-item.entity';
+
+// orders jadvali. Jadvalni migratsiya yaratadi (src/database/migrations).
+@Entity({ name: 'orders' })
+@Check('CHK_orders_total', '"total" >= 0')
+@Check(
+  'CHK_orders_status',
+  `"status" IN ('NEW', 'CONFIRMED', 'DELIVERED', 'CANCELLED')`,
+)
+export class OrderEntity {
+  @PrimaryGeneratedColumn()
+  id: number;
+
+  @Index('IDX_orders_telegram_id')
+  @Column({ name: 'telegram_id', type: 'bigint', transformer: bigintToNumber })
+  telegramId: number;
+
+  @Column({ type: 'varchar', length: 20 })
+  phone: string;
+
+  @Column({ type: 'integer' })
+  total: number; // so'm
+
+  @Column({ type: 'varchar', length: 20, default: 'NEW' })
+  status: OrderStatus;
+
+  @CreateDateColumn({ name: 'created_at', type: 'timestamptz' })
+  createdAt: Date;
+
+  @ManyToOne(() => UserEntity, { onDelete: 'RESTRICT' })
+  @JoinColumn({
+    name: 'telegram_id',
+    referencedColumnName: 'telegramId',
+    foreignKeyConstraintName: 'FK_orders_user',
+  })
+  user?: UserEntity;
+
+  @OneToMany(() => OrderItemEntity, (i) => i.order)
+  items: OrderItemEntity[];
+}
