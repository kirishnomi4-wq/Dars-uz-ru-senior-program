diff --git a/src/api/user/user.entity.ts b/src/api/user/user.entity.ts
new file mode 100644
index 0000000..7042f02
--- /dev/null
+++ b/src/api/user/user.entity.ts
@@ -0,0 +1,44 @@
+import {
+  Check,
+  Column,
+  CreateDateColumn,
+  Entity,
+  PrimaryColumn,
+} from 'typeorm';
+import type { Role, User, UserState } from '../../core/types';
+
+// pg BIGINT ni satr ("5123456789") qilib qaytaradi — kodda son bo'lsin.
+// Telegram id 52 bitdan oshmaydi, JS Number uchun xavfsiz.
+const bigintToNumber = {
+  to: (v: number) => v,
+  from: (v: string | null) => (v === null ? v : Number(v)),
+};
+
+// users jadvali. Jadvalni migratsiya yaratadi (src/database/migrations).
+@Entity({ name: 'users' })
+@Check('CHK_users_role', `"role" IN ('customer', 'admin')`)
+@Check('CHK_users_state', `"state" IN ('IDLE', 'WAITING_PHONE')`)
+export class UserEntity implements User {
+  @PrimaryColumn({
+    name: 'telegram_id',
+    type: 'bigint',
+    transformer: bigintToNumber,
+  })
+  telegramId: number;
+
+  @Column({ type: 'varchar', length: 255 })
+  name: string;
+
+  @Column({ type: 'varchar', length: 20, nullable: true })
+  phone: string | null;
+
+  @Column({ type: 'varchar', length: 20, default: 'customer' })
+  role: Role;
+
+  // Suhbat holati bazada: server qayta ishga tushsa ham telefon kutilayotgani esda qoladi
+  @Column({ type: 'varchar', length: 20, default: 'IDLE' })
+  state: UserState;
+
+  @CreateDateColumn({ name: 'created_at', type: 'timestamptz' })
+  createdAt: Date;
+}
