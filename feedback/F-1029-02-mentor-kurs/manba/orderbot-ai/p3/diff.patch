@@ -0,0 +1,54 @@
+import {
+  Check,
+  Column,
+  CreateDateColumn,
+  Entity,
+  JoinColumn,
+  ManyToOne,
+  PrimaryGeneratedColumn,
+  Unique,
+} from 'typeorm';
+import { ProductEntity } from '../catalog/product.entity';
+import { UserEntity } from '../user/user.entity';
+
+// pg BIGINT ni satr qilib qaytaradi — kodda son bo'lsin (user.entity.ts dagi kabi)
+const bigintToNumber = {
+  to: (v: number) => v,
+  from: (v: string | null) => (v === null ? v : Number(v)),
+};
+
+// cart_items jadvali. Jadvalni migratsiya yaratadi (src/database/migrations).
+@Entity({ name: 'cart_items' })
+@Unique('UQ_cart_items_user_product', ['telegramId', 'productId'])
+@Check('CHK_cart_items_qty', '"qty" > 0')
+export class CartItemEntity {
+  @PrimaryGeneratedColumn()
+  id: number;
+
+  @Column({ name: 'telegram_id', type: 'bigint', transformer: bigintToNumber })
+  telegramId: number;
+
+  @Column({ name: 'product_id', type: 'integer' })
+  productId: number;
+
+  @Column({ type: 'integer', default: 1 })
+  qty: number;
+
+  @CreateDateColumn({ name: 'created_at', type: 'timestamptz' })
+  createdAt: Date;
+
+  @ManyToOne(() => UserEntity, { onDelete: 'CASCADE' })
+  @JoinColumn({
+    name: 'telegram_id',
+    referencedColumnName: 'telegramId',
+    foreignKeyConstraintName: 'FK_cart_items_user',
+  })
+  user?: UserEntity;
+
+  @ManyToOne(() => ProductEntity, { onDelete: 'CASCADE' })
+  @JoinColumn({
+    name: 'product_id',
+    foreignKeyConstraintName: 'FK_cart_items_product',
+  })
+  product?: ProductEntity;
+}
