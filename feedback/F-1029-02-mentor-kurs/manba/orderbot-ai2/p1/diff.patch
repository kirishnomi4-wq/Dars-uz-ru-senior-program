+import { Column, Entity, PrimaryColumn } from 'typeorm';
+import type { Role, UserState } from '../../core/types';
+import { bigintNumber } from '../../db/bigint.transformer';
+
+@Entity('users')
+export class UserEntity {
+  @PrimaryColumn({
+    name: 'telegram_id',
+    type: 'bigint',
+    transformer: bigintNumber,
+  })
+  telegramId!: number;
+
+  @Column({ type: 'varchar', length: 255 })
+  name!: string;
+
+  @Column({ type: 'varchar', length: 32, nullable: true })
+  phone!: string | null;
+
+  @Column({ type: 'varchar', length: 16, default: 'customer' })
+  role!: Role;
+
+  @Column({ type: 'varchar', length: 16, default: 'IDLE' })
+  state!: UserState;
+}
