+import {
+  Column,
+  CreateDateColumn,
+  Entity,
+  JoinColumn,
+  ManyToOne,
+  OneToMany,
+  PrimaryGeneratedColumn,
+} from 'typeorm';
+import type { Order, OrderItem, OrderStatus } from '../../core/types';
+import { bigintNumber } from '../../db/bigint.transformer';
+
+@Entity('orders')
+export class OrderEntity implements Order {
+  @PrimaryGeneratedColumn()
+  id!: number;
+
+  @Column({ name: 'telegram_id', type: 'bigint', transformer: bigintNumber })
+  telegramId!: number;
+
+  @Column({ type: 'varchar', length: 32 })
+  phone!: string;
+
+  @Column({ type: 'integer' })
+  total!: number;
+
+  @Column({ type: 'varchar', length: 16, default: 'NEW' })
+  status!: OrderStatus;
+
+  @CreateDateColumn({ name: 'created_at', type: 'timestamptz' })
+  createdAt!: Date;
+
+  @OneToMany(() => OrderItemEntity, (i) => i.order, { cascade: true })
+  items!: OrderItemEntity[];
+}
+
+// Ikkala entity bitta faylda: relation'lar o'zaro bog'liq (circular import xavfi yo'q)
+@Entity('order_items')
+export class OrderItemEntity implements OrderItem {
+  @PrimaryGeneratedColumn()
+  id!: number;
+
+  @ManyToOne(() => OrderEntity, (o) => o.items, { onDelete: 'CASCADE' })
+  @JoinColumn({ name: 'order_id' })
+  order!: OrderEntity;
+
+  @Column({ name: 'product_id', type: 'integer' })
+  productId!: number;
+
+  @Column({ type: 'varchar', length: 255 })
+  name!: string;
+
+  // buyurtma paytidagi narx
+  @Column({ type: 'integer' })
+  price!: number;
+
+  @Column({ type: 'integer' })
+  qty!: number;
+}
