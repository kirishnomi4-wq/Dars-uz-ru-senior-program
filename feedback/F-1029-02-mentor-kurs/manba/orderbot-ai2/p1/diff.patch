--- /dev/null
+++ b/src/db/bigint.transformer.ts
@@ -0,0 +1,7 @@
+import { ValueTransformer } from 'typeorm';
+
+// Telegram id'lari bigint: Postgres uni string qaytaradi — biz number bilan ishlaymiz
+export const bigintNumber: ValueTransformer = {
+  to: (v: number | null) => v,
+  from: (v: string | null) => (v === null ? null : Number(v)),
+};
