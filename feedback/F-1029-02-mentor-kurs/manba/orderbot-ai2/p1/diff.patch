+import { Module } from '@nestjs/common';
+import { TypeOrmModule } from '@nestjs/typeorm';
+import { config } from '../config';
+import { Init1762000000000 } from './migrations/1762000000000-Init';
+
+// PostgreSQL ulanishi. Migratsiyalar serverda avtomatik yuriydi (migrationsRun).
+// synchronize o'chiq: jadvallar faqat migratsiya orqali o'zgaradi.
+@Module({
+  imports: [
+    TypeOrmModule.forRootAsync({
+      useFactory: () => {
+        if (!config.DATABASE_URL) {
+          throw new Error(
+            'DATABASE_URL topilmadi. .env faylini tekshiring (README).',
+          );
+        }
+        return {
+          type: 'postgres',
+          url: config.DATABASE_URL,
+          autoLoadEntities: true,
+          synchronize: false,
+          migrations: [Init1762000000000],
+          migrationsRun: true,
+        };
+      },
+    }),
+  ],
+})
+export class DatabaseModule {}
