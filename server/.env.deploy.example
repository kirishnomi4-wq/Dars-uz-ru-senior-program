# dars-api — LMS serverida prod/staging uchun env. Nusxa: cp .env.deploy.example .env.deploy (repo'ga TUSHMAYDI).
# Sirlarni LMS jamoasi o'zi to'ldiradi (ularda bor); biz faqat nomlarni beramiz.

# ---- compose o'zgaruvchilari
POSTGRES_PASSWORD=          # kuchli parol, faqat shu compose ichida ishlatiladi
POSTGRES_DB=dars_prod       # staging: dars_staging
API_PORT=3001               # host'da 127.0.0.1:<port>; staging: 3002
IMAGE_TAG=latest
GIT_SHA=                    # CI to'ldiradi
BACKUP_KEEP_DAYS=14

# ---- ilova
DARS_ENV=prod               # staging: staging
LOG_LEVEL=info
CORS_ORIGINS=https://lms.coddycamp.uz
LIVE_MENTOR_CODE=           # PIN-yo'li mentor-kodi (zaxira yo'l), 8+ belgi
RATE_LIMIT_PER_MIN=300

# ---- LMS-ko'prik (qiymatlar LMS jamoasida)
CODDYCAMP_SCHOOL_API_URL=https://school-api.coddycamp.uz
CODDYCAMP_CONTEXT_API_TOKEN=
CODDYCAMP_RESULTS_API_TOKEN=
CODDYCAMP_LIVE_JWT_SECRET=
CODDYCAMP_LIVE_JWT_ISSUER=coddycamp-lms
CODDYCAMP_LIVE_JWT_AUDIENCE=dars-platform
CODDYCAMP_LIVE_JWT_KEY_ID=v1
# Rotatsiya (SIRLAR_ROTATSIYASI_UZ.md): ikkinchi kalit — ikkalasi parallel qabul qilinadi, keyin asosiyga ko'chiriladi
# CODDYCAMP_LIVE_JWT_SECRET_NEXT=
# CODDYCAMP_LIVE_JWT_KEY_ID_NEXT=v2
CODDYCAMP_LIVE_JWT_MAX_TTL_SECONDS=43200
TOKEN_ENC_KEY=              # openssl rand -base64 32
CONTEXT_CACHE_TTL_SECONDS=300
# TRUST_PROXY=loopback,172.16.0.0/12   # ixtiyoriy: ishonchli tarmoqlar (docker ko`prigi). Son bermang — req.ip hammaga bitta bo`lib qoladi

# ---- natija-navbat, kuzatuv, admin
RESULTS_WORKER_ENABLED=true
RESULTS_TICK_MS=5000
RESULT_DETAILS=off          # off | a — LMS natija-detallari kontraktini tasdiqlagach `a` (TZ_LESSON_RESULT_DETAILS_RU)
TELEGRAM_BOT_TOKEN=         # ixtiyoriy, ikkalasi birga
TELEGRAM_CHAT_ID=
ADMIN_USER=                 # /admin sahifa (basic auth), parol 12+ belgi
ADMIN_PASSWORD=
