# dars-api — lokal ishlab chiqish namunasi. Nusxa: cp .env.example .env
# Prod/staging qiymatlari serverda /etc/dars-api/<env>.env da turadi, repo'ga tushmaydi.

# dev | test | staging | prod
DARS_ENV=dev

# Prod/staging da faqat 127.0.0.1 (Caddy orqasida). Lokalda ham shu yetadi.
HOST=127.0.0.1
PORT=3001

# fatal | error | warn | info | debug | trace
LOG_LEVEL=debug

# Ilova ulanishi (prod: dars_app roli — DDL huquqisiz)
DATABASE_URL=postgres://dars:dars@127.0.0.1:5433/dars_dev
# Migratsiya ulanishi (prod: dars_migrator roli). Bo'sh bo'lsa DATABASE_URL ishlatiladi.
# MIGRATE_DATABASE_URL=

# Vergul bilan: faqat sxema+host, yo'lsiz. Prod/staging da majburiy.
CORS_ORIGINS=http://localhost:5173

# PIN-yo'lidagi mentor-kod (app_config.mentor_code ga startda sinxronlanadi). Prod/staging da majburiy.
LIVE_MENTOR_CODE=MENTOR-DEV

# IP bo'yicha umumiy limit (so'rov/daqiqa)
RATE_LIMIT_PER_MIN=300

# Caddy orqasida true (X-Forwarded-For ga ishonish). Lokalda false.
TRUST_PROXY=false

# deploy.sh to'ldiradi; health'da ko'rinadi
GIT_SHA=dev

# ---- LMS-ko'prik (2-bosqich). Hammasi berilsa /api/v1/lms/* yoqiladi; dev'da bo'sh qoldirsangiz 503.
# Prod qiymatlari: ../.env.coddycamp.local (gitignored) → serverda /etc/dars-api/<env>.env
CODDYCAMP_SCHOOL_API_URL=https://school-api.coddycamp.uz
CODDYCAMP_CONTEXT_API_TOKEN=
CODDYCAMP_RESULTS_API_TOKEN=
# LMS v5-javobi: iss=coddycamp-lms · aud=dars-platform · kid=v1. Secret `base64:<...>` yoki oddiy satr.
CODDYCAMP_LIVE_JWT_SECRET=
CODDYCAMP_LIVE_JWT_ISSUER=coddycamp-lms
CODDYCAMP_LIVE_JWT_AUDIENCE=dars-platform
CODDYCAMP_LIVE_JWT_KEY_ID=v1
# Rotatsiya (ikkinchi kalit), ikkalasi birga:
# CODDYCAMP_LIVE_JWT_SECRET_NEXT=
# CODDYCAMP_LIVE_JWT_KEY_ID_NEXT=v2
CODDYCAMP_LIVE_JWT_MAX_TTL_SECONDS=43200
# Bazadagi sessiya-tokenlar shifri: openssl rand -base64 32
TOKEN_ENC_KEY=
CONTEXT_CACHE_TTL_SECONDS=300
SCHOOL_API_TIMEOUT_MS=5000

# ---- Natija-navbat va kuzatuv (4-bosqich)
RESULTS_WORKER_ENABLED=true
RESULTS_TICK_MS=5000
# Natija-detallari (TZ_LESSON_RESULT_DETAILS_RU): off = faqat asosiy natija · a = lang + questions[] + achievements[] o'sha hodisada.
# LMS kontraktni tasdiqlaguncha off qoladi.
RESULT_DETAILS=off
# Telegram ogohlantirish (ixtiyoriy, ikkalasi birga): manual_review, rejected_students, server yiqilishi
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Admin-sahifa /admin (basic auth, ixtiyoriy, ikkalasi birga; parol ≥12)
# ADMIN_USER=
# ADMIN_PASSWORD=
